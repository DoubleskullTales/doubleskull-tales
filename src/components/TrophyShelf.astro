---
import Base from '../layouts/Base.astro';
import { trophies } from '../data/trophies';
const wins = trophies.filter((t) => t.award === '1st' || t.award === 'Champion').length;
const podiums = trophies.filter((t) => t.award === '2nd' || t.award === '3rd').length;
const cas = trophies.filter((t) => t.award === 'Most Casualties').length;
const badge = (a: string) => a === 'Most Casualties' ? { cls: 'cas', top: 'Most', big: 'CAS' }
  : a === 'Champion' ? { cls: 'win', top: 'League', big: 'Champ' }
  : a === '1st' ? { cls: 'win', top: 'Place', big: '1st' }
  : { cls: 'pod', top: 'Place', big: a };
---
<Base title="The Trophy Shelf" description="Tournament results and awards of Lewdgrip, coach since 1996." image="/images/krampusbowl-trophies.jpg">
  <div class="page">
    <h1>The Trophy Shelf</h1>
    <p><em>Every trophy on this shelf comes with a story, a team and a lot of dice that could have gone the other way.</em></p>
    <p>Here's what my teams have brought home so far. Most of it from tournaments here in Vienna, one from Budapest, and all of it thanks to great opponents who made every game worth playing.</p>

    <div class="shelf-stats">
      <div><span>{wins}</span><b>Titles</b></div>
      <div><span>{podiums}</span><b>Podiums</b></div>
      <div><span>{cas}</span><b>Most Casualties</b></div>
    </div>

    <div class="trophies">
      {trophies.map((t) => {
        const b = badge(t.award);
        return (
          <article class="trophy">
            <div class={`tbadge ${b.cls}`}><small>{b.top}</small><span>{b.big}</span></div>
            <div class="tbody">
              <h3>{t.event}</h3>
              <div class="tmeta">{t.year} &middot; {t.city} &middot; {t.race}</div>
              {t.story && <p>{t.story}</p>}
            </div>
          </article>
        );
      })}
    </div>

    <figure class="photo">
      <img src="/images/krampusbowl-trophies.jpg" alt="Two Krampusbowl trophies: snow globes with Krampus figures, one on a fur base with a clawed hand, one on a black base" />
      <figcaption>The Krampusbowl snow globes, 3rd place in 2024 and 2025.</figcaption>
    </figure>

    <p class="muted" style="margin-top:30px"><em>Next stop: Krampusbowl 10. <a href="/tales/krampusbowl-10-preview/">Read the preview</a>.</em></p>
  </div>
</Base>
