---
import Base from '../../layouts/Base.astro';
import { render } from 'astro:content';
import { getTales } from '../../lib';
import { SITE } from '../../site';
export async function getStaticPaths() {
  const tales = await getTales();
  return tales.map((tale) => ({ params: { id: tale.id }, props: { tale } }));
}
const { tale } = Astro.props;
const { Content } = await render(tale);
const d = tale.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={tale.data.title} description={tale.data.subtitle} image={tale.data.image}>
  <header class="article-head">
    <div class="label">{tale.data.section}</div>
    <h1>{tale.data.title}</h1>
    {tale.data.subtitle && <p class="sub">{tale.data.subtitle}</p>}
    <div class="meta">By {SITE.author} &middot; {d}</div>
  </header>
  {tale.data.image && (
    <figure class="hero-fig">
      <img class="hero-img" src={tale.data.image} alt="" />
      {tale.data.imageCaption && <figcaption>{tale.data.imageCaption}</figcaption>}
    </figure>
  )}
  <div class="prose"><Content /></div>
  <p style="text-align:center;margin-top:50px"><a class="btn dark" href="/tales/">More tales</a></p>
</Base>
