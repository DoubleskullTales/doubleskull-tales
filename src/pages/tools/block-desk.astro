---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site';
---
<Base image="/images/tool-action-block.jpg" title="The Block Desk" description="Will he go down, or will you? Set strength, assists and skills, and the Block Desk works out every block result, armour and injury included, with Frenzy, Juggernaut, Horns, Mighty Blow and re-rolls.">
  <div class="page bd-page">
    <p class="bd-back"><a href="/tools/">← All tools</a></p>
    <p class="bd-kicker">Tools · Dice maths</p>
    <h1>The Block Desk</h1>
    <p class="bd-intro"><em>Two dice, a Block skill and a dream. Or one die, no skills and a team re-roll you really shouldn't spend. Before you throw, see what's actually waiting for you.</em></p>

    <figure class="tool-hero"><img src="/images/tool-action-block.jpg" alt="A grinning orc in heavy armour slams a human lineman off his feet in a spray of mud." width="1200" height="600" /><figcaption>Our head of research, collecting data. Illustration: AI-generated.</figcaption></figure>

    <div id="bd-app">
      <div class="bd-sides">
        <fieldset class="bd-side">
          <legend>You <span>(blocking)</span></legend>
          <div class="bd-st"><span class="bd-l">Strength incl. assists</span>
            <span class="bd-stepper"><button type="button" class="bd-step" data-who="a" data-d="-1" aria-label="Your strength minus one">&minus;</button><span class="bd-stv" id="bd-ast">4</span><button type="button" class="bd-step" data-who="a" data-d="1" aria-label="Your strength plus one">+</button></span>
          </div>
          <div class="bd-skills">
            <label><input type="checkbox" id="bd-a-block"> Block</label>
            <label><input type="checkbox" id="bd-a-wrestle"> Wrestle</label>
            <label><input type="checkbox" id="bd-a-tackle"> Tackle</label>
            <label><input type="checkbox" id="bd-a-brawler"> Brawler</label>
            <label><input type="checkbox" id="bd-a-pro"> Pro</label>
            <label><input type="checkbox" id="bd-a-frenzy"> Frenzy</label>
            <label><input type="checkbox" id="bd-a-juggernaut"> Juggernaut</label>
            <label><input type="checkbox" id="bd-a-horns"> Horns</label>
            <label><input type="checkbox" id="bd-a-claw"> Claw</label>
            <label class="bd-mbl"><input type="checkbox" id="bd-a-mightyBlow"> Mighty Blow
              <select id="bd-mb" aria-label="Mighty Blow bonus"><option value="1">+1</option><option value="2">+2</option></select></label>
          </div>
        </fieldset>
        <fieldset class="bd-side">
          <legend>Him <span>(getting hit)</span></legend>
          <div class="bd-st"><span class="bd-l">Strength incl. assists</span>
            <span class="bd-stepper"><button type="button" class="bd-step" data-who="d" data-d="-1" aria-label="His strength minus one">&minus;</button><span class="bd-stv" id="bd-dst">3</span><button type="button" class="bd-step" data-who="d" data-d="1" aria-label="His strength plus one">+</button></span>
          </div>
          <div class="bd-skills">
            <label><input type="checkbox" id="bd-d-block"> Block</label>
            <label><input type="checkbox" id="bd-d-wrestle"> Wrestle</label>
            <label><input type="checkbox" id="bd-d-dodge"> Dodge</label>
            <label><input type="checkbox" id="bd-d-thickSkull"> Thick Skull</label>
            <label><input type="checkbox" id="bd-d-stunty"> Stunty</label>
          </div>
          <div class="bd-st bd-av"><span class="bd-l">Armour value</span>
            <select id="bd-av" aria-label="His armour value"><option value="6">6+</option><option value="7">7+</option><option value="8">8+</option><option value="9" selected>9+</option><option value="10">10+</option><option value="11">11+</option></select>
          </div>
        </fieldset>
      </div>
      <p class="bd-dicebar">Block dice: <strong id="bd-dice">-</strong></p>

      <div class="bd-opts">
        <div class="bd-group"><span class="bd-l">Action</span>
          <button type="button" class="bd-tog" data-action="block" aria-pressed="true">Block</button>
          <button type="button" class="bd-tog" data-action="blitz" aria-pressed="false">Blitz</button>
        </div>
        <div class="bd-group"><span class="bd-l">Your goal</span>
          <button type="button" class="bd-tog" data-goal="hit" aria-pressed="true">Knock him down</button>
          <button type="button" class="bd-tog" data-goal="safe" aria-pressed="false">No turnover</button>
        </div>
        <div class="bd-group bd-rr"><span class="bd-l">Re-rolls</span>
          <label><input type="checkbox" id="bd-rr" checked> Team re-roll left</label>
          <label>Loner
            <select id="bd-loner"><option value="0">No</option><option value="2">2+</option><option value="3">3+</option><option value="4">4+</option><option value="5">5+</option></select>
          </label>
        </div>
      </div>
      <p class="bd-note" id="bd-brawl-note" hidden></p>

      <div class="bd-result" aria-live="polite">
        <div class="bd-bigs">
          <div class="bd-big"><span class="bd-l">He goes down</span><span class="bd-pct" id="bd-down">-</span></div>
          <div class="bd-big bd-big2"><span class="bd-l">Turnover risk</span><span class="bd-pct" id="bd-turn">-</span></div>
        </div>
        <div class="bd-say">
          <p class="bd-verdict" id="bd-verdict"></p>
          <p class="bd-sub" id="bd-sub"></p>
          <ul class="bd-rows" id="bd-rows"></ul>
          <p class="bd-facts" id="bd-facts"></p>
        </div>
      </div>
      <div class="bd-hurt" aria-live="polite">
        <div><span class="bd-l">Armour broken</span><span class="bd-hv" id="bd-broken">-</span></div>
        <div><span class="bd-l">KO or worse</span><span class="bd-hv" id="bd-ko">-</span></div>
        <div><span class="bd-l">Casualty</span><span class="bd-hv bd-hcas" id="bd-cas">-</span></div>
      </div>
      <p class="bd-hurtnote" id="bd-hurtnote"></p>
      <button type="button" class="btn dark bd-share" id="bd-share">Copy link to this block</button>
      <input type="text" class="bd-link" id="bd-link" readonly hidden aria-label="Link to this block" />
    </div>

    <h2>How to use it</h2>
    <ul>
      <li>Set both strengths <strong>including assists</strong>. The Block Desk works out the dice: same strength is one die, stronger is two, more than double is three. If he's stronger, he picks.</li>
      <li>Tick the skills on both sides and tell it what re-rolls you have left.</li>
      <li>Pick your goal. <strong>Knock him down</strong> re-rolls anything that doesn't put him on the floor. <strong>No turnover</strong> only re-rolls when you'd end up on the floor yourself, and takes the push otherwise.</li>
      <li>"He goes down" counts every result where he needs an armour roll, including Both Down. "Turnover risk" counts every result where you go down.</li>
      <li>Armour broken, KO or worse and Casualty are your chances from this one block, start to finish. Your own armour roll on a Both Down isn't counted.</li>
    </ul>

    <h2>How the Block Desk counts</h2>
    <ul class="bd-rules">
      <li>Block dice: one Skull, one Both Down, two Pushes, one Stumble, one Pow.</li>
      <li>Both Down: Block keeps a player standing. Wrestle places both players prone instead, with no armour roll and no turnover, and whoever has it uses it when it helps them.</li>
      <li>Stumble: counts as a Push if he has Dodge, unless you have Tackle.</li>
      <li>Team re-roll: re-rolls all block dice, once per turn. With Loner, roll first. Pro: once per turn, a 3+ re-rolls one die. Brawler: re-rolls one Both Down, only on a Block action.</li>
      <li>No die is re-rolled twice. Once Pro or Brawler has re-rolled a die, the team re-roll can't be used on that block.</li>
      <li>Frenzy: if he's pushed and still standing, you hit him again. The second block uses the same dice and whatever re-rolls are left. Brawler works once per activation.</li>
      <li>Horns: +1 ST on a Blitz. Juggernaut: on a Blitz, a Both Down can be a Push instead, and he can't use Wrestle.</li>
      <li>Armour breaks when 2D6 reach his armour value. Claw breaks it on 8 or more, whatever the value. Mighty Blow adds to the armour roll, or to the injury roll if the armour broke without it.</li>
      <li>Injury: 2 to 7 Stunned, 8 or 9 KO, 10 or more Casualty. Thick Skull turns an 8 into Stunned. Stunty: 2 to 6 Stunned, 7 or 8 KO, 9 or more Casualty (with Thick Skull, a 7 is Stunned).</li>
      <li>Not included: Stand Firm, Fend, Sidestep, Grab, Dauntless, Piling On, Dirty Player and the ball. Frenzy on a Blitz may need an extra Rush, which isn't counted.</li>
    </ul>
    <p>Need the odds for the run before the hit? Try <a href="/tools/odds-desk/">The Odds Desk</a>. Feeling brave? <a href="/tools/pass-desk/">The Pass Desk</a>. Is he down? <a href="/tools/foul-desk/">The Foul Desk</a>.</p>
    <p class="bd-fine">Rules as we read them in the current rulebook. Spotted something that doesn't match your book? <a href={`mailto:${SITE.email}?subject=Block%20Desk`}>Tell us</a> and we'll fix it.</p>
    <p class="bd-fine"><strong>Unofficial fan tool.</strong> Not affiliated with or endorsed by Games Workshop. Everything is calculated in your browser. Nothing is stored or sent anywhere.</p>
  </div>

  <style>
    .tool-hero { margin: 1.2em 0 0; }
    .tool-hero img { display: block; width: 100%; height: auto; border: 3px solid var(--ink); }
    .tool-hero figcaption { font-family: 'Inter', sans-serif; font-size: .78rem; color: var(--muted); margin-top: 6px; }
    .bd-back { font-family: 'Inter', sans-serif; font-size: .8rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; margin: 0 0 .6em; }
    .bd-back a { text-decoration: none; }
    .bd-kicker { font-family: 'Inter', sans-serif; font-weight: 700; letter-spacing: .3em; text-transform: uppercase; font-size: .8rem; color: var(--red); }
    .bd-intro { font-size: 1.2rem; }
    .bd-l { font-family: 'Inter', sans-serif; font-size: .68rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--muted); }
    .bd-sides { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-top: 1.4em; }
    .bd-side { border: 3px solid var(--ink); border-top-width: 10px; padding: 12px 16px 16px; min-width: 0; }
    .bd-side legend { font-family: 'Anton', sans-serif; font-size: 1.5rem; text-transform: uppercase; padding: 0 6px; }
    .bd-side legend span { font-family: 'Crimson Text', serif; font-style: italic; text-transform: none; font-size: 1rem; color: var(--muted); }
    .bd-st { display: flex; align-items: center; justify-content: space-between; gap: 10px; }
    .bd-stepper { display: flex; align-items: center; border: 2.5px solid var(--ink); }
    .bd-step { width: 38px; height: 38px; border: none; background: transparent; font-size: 1.4rem; cursor: pointer; color: var(--ink); }
    .bd-step:hover { background: var(--ink); color: var(--paper); }
    .bd-stv { font-family: 'Anton', sans-serif; font-size: 1.6rem; min-width: 40px; text-align: center; border-left: 2px solid var(--ink); border-right: 2px solid var(--ink); line-height: 38px; }
    .bd-skills { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 12px; font-family: 'Inter', sans-serif; font-size: .88rem; }
    .bd-skills label, .bd-rr label { display: flex; align-items: center; gap: 6px; cursor: pointer; }
    .bd-page input[type=checkbox] { width: 18px; height: 18px; accent-color: var(--red); }
    .bd-dicebar { font-family: 'Inter', sans-serif; font-size: .9rem; margin-top: .8em !important; text-align: center; }
    .bd-dicebar strong { font-family: 'Anton', sans-serif; font-weight: 400; font-size: 1.3rem; text-transform: uppercase; color: var(--red); margin-left: 6px; }
    .bd-opts { display: flex; flex-wrap: wrap; gap: 14px 30px; margin-top: 1em; align-items: center; }
    .bd-group { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-family: 'Inter', sans-serif; font-size: .88rem; }
    .bd-group .bd-l { width: 100%; }
    .bd-tog { font-family: 'Inter', sans-serif; font-weight: 700; font-size: .8rem; letter-spacing: .06em; text-transform: uppercase; padding: 7px 12px; border: 2.5px solid var(--ink); background: transparent; color: var(--ink); cursor: pointer; }
    .bd-tog[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
    .bd-rr select { font-family: 'Inter', sans-serif; font-size: .88rem; padding: 4px 6px; border: 2px solid var(--ink); background: var(--paper); color: var(--ink); }
    .bd-rr select:disabled { opacity: .45; }
    .bd-note { font-family: 'Inter', sans-serif; font-size: .8rem; color: var(--red); }
    .bd-mbl select, .bd-av select { font-family: 'Inter', sans-serif; font-size: .85rem; padding: 3px 4px; border: 2px solid var(--ink); background: var(--paper); color: var(--ink); }
    .bd-mbl select:disabled { opacity: .45; }
    .bd-av { margin-top: 12px; }
    .bd-hurt { display: grid; grid-template-columns: repeat(3, 1fr); border: 3px solid var(--ink); border-top: none; background: var(--paper); }
    .bd-hurt > div { display: flex; flex-direction: column; padding: 10px 16px; border-right: 2px solid var(--ink); }
    .bd-hurt > div:last-child { border-right: none; }
    .bd-hv { font-family: 'Anton', sans-serif; font-size: 1.8rem; line-height: 1.1; }
    .bd-hcas { color: var(--red); }
    .bd-hurtnote { font-family: 'Inter', sans-serif; font-size: .8rem; color: var(--muted); margin-top: .5em !important; }
    .bd-result { display: grid; grid-template-columns: 210px 1fr; margin-top: 1.4em; border: 3px solid var(--ink); border-top-width: 10px; background: var(--paper-dark); }
    .bd-bigs { display: flex; flex-direction: column; border-right: 3px solid var(--ink); }
    .bd-big { flex: 1; display: flex; flex-direction: column; justify-content: center; padding: 14px 18px; }
    .bd-big2 { border-top: 2px solid var(--ink); }
    .bd-pct { font-family: 'Anton', sans-serif; font-size: 3.2rem; line-height: 1; color: var(--red); }
    .bd-big2 .bd-pct { color: var(--ink); font-size: 2.2rem; }
    .bd-say { padding: 16px 20px; }
    .bd-say p { margin: 0 !important; }
    .bd-verdict { font-family: 'Anton', sans-serif; font-size: 1.7rem; text-transform: uppercase; line-height: 1.05; }
    .bd-sub { font-style: italic; font-size: 1.15rem; margin-top: 4px !important; }
    .bd-rows { list-style: none; padding: 0 !important; margin: 12px 0 10px !important; display: flex; flex-direction: column; gap: 6px; }
    :global(.bd-row) { display: grid; grid-template-columns: 190px 1fr 54px; align-items: center; gap: 10px; font-family: 'Inter', sans-serif; font-size: .82rem; }
    :global(.bd-rb) { height: 12px; border: 2px solid var(--ink); background: var(--paper); }
    :global(.bd-rb span) { display: block; height: 100%; background: var(--muted); }
    :global(.bd-def .bd-rb span), :global(.bd-both .bd-rb span) { background: var(--red); }
    :global(.bd-att .bd-rb span) { background: var(--ink); }
    :global(.bd-rv) { font-family: 'Anton', sans-serif; font-size: 1rem; text-align: right; }
    .bd-facts { font-family: 'Inter', sans-serif; font-size: .82rem; color: var(--muted); line-height: 1.6; }
    .bd-facts :global(strong) { color: var(--ink); }
    .bd-share { display: block; width: 100%; margin-top: 12px; cursor: pointer; }
    .bd-link { width: 100%; margin-top: 8px; padding: 8px; font-family: 'Inter', sans-serif; font-size: .8rem; border: 2px solid var(--ink); background: var(--paper); }
    .bd-rules li { margin-top: .3em; }
    .bd-fine { font-family: 'Inter', sans-serif; font-size: .8rem; color: var(--muted); }
    @media (max-width: 680px) {
      .bd-sides { grid-template-columns: 1fr; }
      .bd-result { grid-template-columns: 1fr; }
      .bd-bigs { flex-direction: row; border-right: none; border-bottom: 3px solid var(--ink); }
      .bd-big2 { border-top: none; border-left: 2px solid var(--ink); }
      :global(.bd-row) { grid-template-columns: 1fr 50px; }
      :global(.bd-rb) { grid-column: 1 / 3; grid-row: 2; }
    }
  </style>
  <script is:inline src="/block-desk.js" defer></script>
</Base>
