---
import Base from '../../layouts/Base.astro';
import { SITE } from '../../site';
const sel = (min: number, max: number, suffix = '') => Array.from({ length: max - min + 1 }, (_, i) => min + i).map((v) => ({ v, l: v + suffix }));
---
<Base title="The Pass Desk" description="How far is that pass, and will anyone actually catch it? Or will the goblin land on his feet? Pick the target square and the Pass Desk shows the range, what you need to roll and your chances.">
  <div class="page pd-page">
    <p class="pd-back"><a href="/tools/">← All tools</a></p>
    <p class="pd-kicker">Tools · Dice maths</p>
    <h1>The Pass Desk</h1>
    <p class="pd-intro"><em>Some teams pass. Most teams just think about it, then hand the ball to the guy with the horns. And some teams throw the goblin instead. Whatever leaves your hands, at least know what you're getting into.</em></p>

    <div id="pd-app">
      <div class="pd-modes" role="group" aria-label="What are you throwing?">
        <button type="button" class="pd-mode" data-mode-btn="pass" aria-pressed="true">Pass the ball</button>
        <button type="button" class="pd-mode" data-mode-btn="ttm" aria-pressed="false">Throw a team-mate</button>
      </div>
      <div class="pd-top">
        <div class="pd-gridwrap">
          <p class="pd-l">Tap the target square. T is your thrower.</p>
          <div class="pd-grid" id="pd-grid"></div>
          <ul class="pd-legend">
            <li><span class="pd-c pd-q">Q</span> Quick</li><li><span class="pd-c pd-s">S</span> Short</li><li><span class="pd-c pd-lp">L</span> Long</li><li><span class="pd-c pd-b">B</span> Long Bomb</li>
          </ul>
          <p class="pd-gridnote">Count squares across and up from the thrower. The range is the same in every direction, so a pass 2 left and 5 down is the same as 5 across and 2 up.</p>
        </div>
        <div class="pd-target">
          <span class="pd-l">Target</span>
          <span class="pd-where" id="pd-where">-</span>
          <span class="pd-band" id="pd-band">-</span>
          <ul class="pd-needs" id="pd-needs"></ul>
        </div>
      </div>

      <div class="pd-sides" data-only="pass">
        <fieldset class="pd-side">
          <legend>Thrower</legend>
          <div class="pd-fields">
            <label>Passing Ability <select id="pd-pa">{sel(1, 6, '+').map((o) => <option value={o.v} selected={o.v === 3}>{o.l}</option>)}</select></label>
            <label>Marked by <select id="pd-tm">{sel(0, 4).map((o) => <option value={o.v}>{o.l}</option>)}</select></label>
            <label>Disturbing Presence near him <select id="pd-tdp"><option value="0">0</option><option value="1">1</option><option value="2">2</option><option value="3">3</option></select></label>
            <label>Loner <select id="pd-tl"><option value="0">No</option><option value="2">2+</option><option value="3">3+</option><option value="4">4+</option><option value="5">5+</option></select></label>
          </div>
          <div class="pd-skills">
            <label><input type="checkbox" id="pd-t-passSkill"> Pass</label>
            <label><input type="checkbox" id="pd-t-accurate"> Accurate</label>
            <label><input type="checkbox" id="pd-t-cannoneer"> Cannoneer</label>
            <label><input type="checkbox" id="pd-t-nos"> Nerves of Steel</label>
            <label><input type="checkbox" id="pd-t-safePass"> Safe Pass</label>
            <label><input type="checkbox" id="pd-t-pro"> Pro</label>
            <label><input type="checkbox" id="pd-t-cloudBurster"> Cloud Burster</label>
          </div>
        </fieldset>
        <fieldset class="pd-side">
          <legend>Receiver</legend>
          <div class="pd-fields">
            <label>Agility <select id="pd-ag">{sel(1, 6, '+').map((o) => <option value={o.v} selected={o.v === 3}>{o.l}</option>)}</select></label>
            <label>Marked by <select id="pd-cm">{sel(0, 4).map((o) => <option value={o.v}>{o.l}</option>)}</select></label>
            <label>Disturbing Presence near him <select id="pd-cdp"><option value="0">0</option><option value="1">1</option><option value="2">2</option><option value="3">3</option></select></label>
            <label>Loner <select id="pd-cl"><option value="0">No</option><option value="2">2+</option><option value="3">3+</option><option value="4">4+</option><option value="5">5+</option></select></label>
          </div>
          <div class="pd-skills">
            <label><input type="checkbox" id="pd-c-catchSkill"> Catch</label>
            <label><input type="checkbox" id="pd-c-diving"> Diving Catch</label>
            <label><input type="checkbox" id="pd-c-extraArms"> Extra Arms</label>
            <label><input type="checkbox" id="pd-c-nos"> Nerves of Steel</label>
          </div>
        </fieldset>
        <fieldset class="pd-side pd-intside">
          <legend><label><input type="checkbox" id="pd-int"> Someone can intercept</label></legend>
          <div id="pd-intbox">
            <div class="pd-fields">
              <label>His Agility <select id="pd-iag">{sel(1, 6, '+').map((o) => <option value={o.v} selected={o.v === 3}>{o.l}</option>)}</select></label>
              <label>Marked by <select id="pd-im">{sel(0, 4).map((o) => <option value={o.v}>{o.l}</option>)}</select></label>
              <label>Your Disturbing Presence near him <select id="pd-idp"><option value="0">0</option><option value="1">1</option><option value="2">2</option><option value="3">3</option></select></label>
            </div>
            <div class="pd-skills">
              <label><input type="checkbox" id="pd-i-vll"> Very Long Legs</label>
              <label><input type="checkbox" id="pd-i-extraArms"> Extra Arms</label>
              <label><input type="checkbox" id="pd-i-stunty"> Stunty</label>
            </div>
          </div>
        </fieldset>
      </div>

      <div class="pd-sides pd-sides2" data-only="ttm" hidden>
        <fieldset class="pd-side">
          <legend>Thrower <span>(big guy)</span></legend>
          <div class="pd-fields">
            <label>Passing Ability <select id="pd-kpa">{sel(1, 6, '+').map((o) => <option value={o.v} selected={o.v === 4}>{o.l}</option>)}</select></label>
            <label>Marked by <select id="pd-km">{sel(0, 4).map((o) => <option value={o.v}>{o.l}</option>)}</select></label>
            <label>Disturbing Presence near him <select id="pd-kdp"><option value="0">0</option><option value="1">1</option><option value="2">2</option><option value="3">3</option></select></label>
            <label>Loner <select id="pd-kl"><option value="0">No</option><option value="2">2+</option><option value="3">3+</option><option value="4">4+</option><option value="5">5+</option></select></label>
          </div>
          <div class="pd-skills">
            <label><input type="checkbox" id="pd-k-strongArm"> Strong Arm</label>
            <label><input type="checkbox" id="pd-k-bullseye"> Bullseye</label>
            <label><input type="checkbox" id="pd-k-hungry"> Always Hungry</label>
            <label><input type="checkbox" id="pd-k-pro"> Pro</label>
          </div>
        </fieldset>
        <fieldset class="pd-side">
          <legend>Thrown player <span>(Right Stuff)</span></legend>
          <div class="pd-fields">
            <label>Agility <select id="pd-pag">{sel(1, 6, '+').map((o) => <option value={o.v} selected={o.v === 3}>{o.l}</option>)}</select></label>
            <label>Marked where he lands <select id="pd-pm">{sel(0, 4).map((o) => <option value={o.v}>{o.l}</option>)}</select></label>
            <label>Loner <select id="pd-pl"><option value="0">No</option><option value="2">2+</option><option value="3">3+</option><option value="4">4+</option><option value="5">5+</option></select></label>
          </div>
          <p class="pd-sidenote">If he falls over, it's only a turnover when he was holding the ball.</p>
        </fieldset>
      </div>

      <div class="pd-opts">
        <label><input type="checkbox" id="pd-rr" checked> Team re-roll left</label>
        <label>Weather
          <select id="pd-w"><option value="nice">Nice</option><option value="sunny">Very Sunny</option><option value="rain">Pouring Rain</option><option value="blizzard">Blizzard</option></select>
        </label>
      </div>

      <div class="pd-result" aria-live="polite">
        <div class="pd-big"><span class="pd-l" id="pd-biglabel">Caught</span><span class="pd-pct" id="pd-pct">-</span></div>
        <div class="pd-say">
          <p class="pd-verdict" id="pd-verdict"></p>
          <p class="pd-sub" id="pd-sub"></p>
          <div class="pd-meter"><span id="pd-bar"></span></div>
          <ul class="pd-rows" id="pd-rows"></ul>
          <p class="pd-facts" id="pd-facts"></p>
        </div>
      </div>
      <button type="button" class="btn dark pd-share" id="pd-share">Copy link to this throw</button>
      <input type="text" class="pd-link" id="pd-link" readonly hidden aria-label="Link to this throw" />
    </div>

    <h2>How the Pass Desk counts</h2>
    <ul class="pd-rules">
      <li>Pass: roll against Passing Ability. Quick 0, Short -1, Long -2, Long Bomb -3, -1 for each player marking the thrower (not with Nerves of Steel), -1 in Very Sunny weather. Accurate gives +1 on Quick and Short, Cannoneer +1 on Long and Long Bomb.</li>
      <li>A natural 6 is always accurate. A natural 1, or 1 or less after modifiers, is a fumble and a turnover. Safe Pass turns a natural 1 into keeping the ball. Any other failed roll is inaccurate and scatters three times, which the Pass Desk counts as not caught.</li>
      <li>Interception: Agility test at -3 against an accurate pass and -2 against an inaccurate one, -1 for each player marking him, -1 in Pouring Rain. Very Long Legs +2, Extra Arms +1, Stunty -1. Cloud Burster stops it. Your re-rolls can't stop it.</li>
      <li>Catch: Agility test, -1 for each player marking the receiver (not with Nerves of Steel), -1 in Pouring Rain, +1 for Diving Catch and Extra Arms. A dropped pass is a turnover.</li>
      <li>Re-rolls: Pass re-rolls a failed pass, Catch a failed catch, Pro (thrower only) a 3+ re-roll once. The team re-roll goes where it helps most: often it's better to keep it for the catch. In a Blizzard only Quick and Short Passes are allowed.</li>
      <li>Disturbing Presence: -1 to the pass, throw, catch or interception for each opposing player with it within 3 squares.</li>
      <li>Loner: before a team re-roll, roll the Loner number or higher. Miss it and the re-roll is gone. Thrower and receiver each use their own Loner.</li>
      <li>Throw Team-mate: Quick or Short range only. Roll against Passing Ability: Quick 0, Short -1, -1 per marker, Strong Arm +1, -1 in Very Sunny weather. Natural 6 or a pass is superb, a natural 1 or 1 or less after modifiers is fumbled, anything else is subpar.</li>
      <li>Superb and subpar throws scatter three times from the target square (Bullseye: a superb throw lands in the target square). A fumbled throw bounces from the thrower. Landing: Agility test, -1 after a subpar or fumbled throw, -1 per marker on the landing square. Where exactly he lands, and whether that square is free, isn't counted.</li>
      <li>Always Hungry: roll a D6 before the throw. On a 1, roll again: another 1 and he's eaten, otherwise he squirms free and it's a fumbled throw. The Pass Desk lets you use Pro or the team re-roll on the first roll.</li>
      <li>Not included: Hail Mary Pass, Leader, Swoop, Throw Bomb, and where an inaccurate pass ends up.</li>
    </ul>
    <p>Rather run it in? <a href="/tools/odds-desk/">The Odds Desk</a> does dodges and rushes, <a href="/tools/block-desk/">The Block Desk</a> does the hitting.</p>
    <p class="pd-fine">Rules as we read them in the current rulebook. Spotted something that doesn't match your book? <a href={`mailto:${SITE.email}?subject=Pass%20Desk`}>Tell us</a> and we'll fix it.</p>
    <p class="pd-fine"><strong>Unofficial fan tool.</strong> Not affiliated with or endorsed by Games Workshop. Everything is calculated in your browser. Nothing is stored or sent anywhere.</p>
  </div>

  <style>
    .pd-back { font-family: 'Inter', sans-serif; font-size: .8rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; margin: 0 0 .6em; }
    .pd-back a { text-decoration: none; }
    .pd-kicker { font-family: 'Inter', sans-serif; font-weight: 700; letter-spacing: .3em; text-transform: uppercase; font-size: .8rem; color: var(--red); }
    .pd-intro { font-size: 1.2rem; }
    .pd-modes { display: flex; gap: 8px; margin-top: 1.2em; flex-wrap: wrap; }
    .pd-mode { font-family: 'Inter', sans-serif; font-weight: 700; font-size: .85rem; letter-spacing: .08em; text-transform: uppercase; padding: 9px 16px; border: 2.5px solid var(--ink); background: transparent; color: var(--ink); cursor: pointer; }
    .pd-mode[aria-pressed="true"] { background: var(--ink); color: var(--paper); }
    .pd-sides2 { grid-template-columns: repeat(2, 1fr); }
    .pd-side legend span { font-family: 'Crimson Text', serif; font-style: italic; text-transform: none; font-size: .95rem; color: var(--muted); }
    .pd-sidenote { font-family: 'Inter', sans-serif; font-size: .75rem; color: var(--muted); margin-top: 10px !important; }
    [hidden] { display: none !important; }
    :global(.pd-dim) { opacity: .25; cursor: not-allowed !important; }
    .pd-l { font-family: 'Inter', sans-serif; font-size: .68rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--muted); }
    .pd-top { display: grid; grid-template-columns: minmax(0, 1fr) 230px; gap: 20px; margin-top: 1.4em; align-items: start; }
    .pd-grid { display: grid; grid-template-columns: 16px repeat(14, minmax(0, 1fr)); gap: 2px; width: 100%; margin-top: 6px; max-width: 500px; }
    :global(.pd-c) { aspect-ratio: 1; display: flex; align-items: center; justify-content: center; font-family: 'Inter', sans-serif; font-weight: 700; font-size: .62rem; border: none; padding: 0; color: var(--ink); min-width: 0; overflow: hidden; }
    :global(button.pd-c) { cursor: pointer; }
    :global(button.pd-c:not(:disabled):hover) { outline: 2px solid var(--ink); outline-offset: -2px; }
    :global(.pd-t) { background: var(--ink); color: var(--paper); }
    :global(.pd-q) { background: #fbf7ee; box-shadow: inset 0 0 0 1px #c9bda3; }
    :global(.pd-s) { background: #e3cf8f; }
    :global(.pd-lp) { background: #b88d45; color: #fff8e8; }
    :global(.pd-b) { background: var(--red); color: var(--paper); }
    :global(.pd-n) { background: repeating-linear-gradient(45deg, transparent 0 3px, rgba(27,23,18,.12) 3px 4px); }
    :global(.pd-sel) { outline: 3px solid var(--ink) !important; outline-offset: -3px; box-shadow: inset 0 0 0 5px var(--paper) !important; }
    :global(.pd-ax) { font-family: 'Inter', sans-serif; font-size: .58rem; color: var(--muted); display: flex; align-items: center; justify-content: center; }
    .pd-legend { list-style: none; padding: 0 !important; display: flex; flex-wrap: wrap; gap: 6px 16px; margin-top: 10px !important; font-family: 'Inter', sans-serif; font-size: .78rem; }
    .pd-legend li { display: flex; align-items: center; gap: 6px; }
    .pd-legend .pd-c { width: 20px; }
    .pd-gridnote { font-family: 'Inter', sans-serif; font-size: .78rem; color: var(--muted); }
    .pd-target { border: 3px solid var(--ink); border-top-width: 10px; padding: 14px 16px; display: flex; flex-direction: column; gap: 4px; background: var(--paper-dark); }
    .pd-where { font-family: 'Inter', sans-serif; font-size: .85rem; }
    .pd-band { font-family: 'Anton', sans-serif; font-size: 1.6rem; text-transform: uppercase; line-height: 1.05; color: var(--red); }
    .pd-needs { list-style: none; padding: 0 !important; margin-top: 8px !important; display: flex; flex-direction: column; gap: 8px; }
    :global(.pd-needs li) { display: grid; grid-template-columns: 1fr auto; font-family: 'Inter', sans-serif; font-size: .82rem; border-top: 2px solid var(--ink); padding-top: 6px; }
    :global(.pd-needs strong) { font-family: 'Anton', sans-serif; font-weight: 400; font-size: 1.3rem; line-height: 1; }
    :global(.pd-needs em) { grid-column: 1 / 3; font-style: normal; font-size: .72rem; color: var(--muted); }
    .pd-sides { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-top: 1.4em; }
    .pd-side { border: 3px solid var(--ink); padding: 10px 14px 14px; min-width: 0; }
    .pd-side legend { font-family: 'Anton', sans-serif; font-size: 1.3rem; text-transform: uppercase; padding: 0 6px; }
    .pd-side legend label { display: flex; align-items: center; gap: 8px; cursor: pointer; }
    .pd-fields { display: flex; flex-direction: column; gap: 6px; font-family: 'Inter', sans-serif; font-size: .85rem; }
    .pd-fields label { display: flex; justify-content: space-between; align-items: center; gap: 8px; }
    .pd-page select { font-family: 'Inter', sans-serif; font-size: .85rem; padding: 3px 4px; border: 2px solid var(--ink); background: var(--paper); color: var(--ink); }
    .pd-skills { display: flex; flex-direction: column; gap: 5px; margin-top: 10px; font-family: 'Inter', sans-serif; font-size: .85rem; }
    .pd-skills label, .pd-opts label { display: flex; align-items: center; gap: 6px; cursor: pointer; }
    .pd-page input[type=checkbox] { width: 18px; height: 18px; accent-color: var(--red); }
    :global(#pd-intbox.pd-off) { opacity: .4; pointer-events: none; }
    .pd-opts { display: flex; flex-wrap: wrap; gap: 10px 28px; margin-top: 1em; font-family: 'Inter', sans-serif; font-size: .9rem; }
    .pd-result { display: grid; grid-template-columns: 210px 1fr; margin-top: 1.4em; border: 3px solid var(--ink); border-top-width: 10px; background: var(--paper-dark); }
    .pd-big { display: flex; flex-direction: column; justify-content: center; padding: 16px 18px; border-right: 3px solid var(--ink); }
    .pd-pct { font-family: 'Anton', sans-serif; font-size: 3.6rem; line-height: 1; color: var(--red); }
    .pd-say { padding: 16px 20px; }
    .pd-say p { margin: 0 !important; }
    .pd-verdict { font-family: 'Anton', sans-serif; font-size: 1.7rem; text-transform: uppercase; line-height: 1.05; }
    .pd-sub { font-style: italic; font-size: 1.15rem; margin-top: 4px !important; }
    .pd-meter { height: 12px; border: 2px solid var(--ink); background: var(--paper); margin: 12px 0 10px; }
    .pd-meter span { display: block; height: 100%; width: 0; background: var(--red); transition: width .25s; }
    .pd-rows { list-style: none; padding: 0 !important; margin: 0 0 10px !important; display: flex; flex-direction: column; gap: 6px; }
    :global(.pd-row) { display: grid; grid-template-columns: 190px 1fr 54px; align-items: center; gap: 10px; font-family: 'Inter', sans-serif; font-size: .82rem; }
    :global(.pd-rb) { height: 10px; border: 2px solid var(--ink); background: var(--paper); }
    :global(.pd-rb span) { display: block; height: 100%; background: var(--muted); }
    :global(.pd-r-caught .pd-rb span), :global(.pd-r-feet .pd-rb span), :global(.pd-r-target .pd-rb span) { background: var(--red); }
    :global(.pd-r-fumble .pd-rb span), :global(.pd-r-intercepted .pd-rb span), :global(.pd-r-eaten .pd-rb span) { background: var(--ink); }
    :global(.pd-rv) { font-family: 'Anton', sans-serif; font-size: 1rem; text-align: right; }
    .pd-facts { font-family: 'Inter', sans-serif; font-size: .82rem; color: var(--muted); }
    .pd-facts :global(strong) { color: var(--ink); }
    .pd-share { display: block; width: 100%; margin-top: 12px; cursor: pointer; }
    .pd-link { width: 100%; margin-top: 8px; padding: 8px; font-family: 'Inter', sans-serif; font-size: .8rem; border: 2px solid var(--ink); background: var(--paper); }
    .pd-rules li { margin-top: .3em; }
    .pd-fine { font-family: 'Inter', sans-serif; font-size: .8rem; color: var(--muted); }
    @media (max-width: 760px) {
      .pd-top { grid-template-columns: 1fr; }
      .pd-sides { grid-template-columns: 1fr; }
      .pd-skills { flex-direction: row; flex-wrap: wrap; gap: 6px 16px; }
      .pd-result { grid-template-columns: 1fr; }
      .pd-big { border-right: none; border-bottom: 3px solid var(--ink); }
      :global(.pd-row) { grid-template-columns: 1fr 50px; }
      :global(.pd-rb) { grid-column: 1 / 3; grid-row: 2; }
      .pd-grid { gap: 1px; }
      :global(.pd-c) { font-size: .5rem; }
      :global(.pd-ax) { font-size: .5rem; }
    }
  </style>
  <script is:inline src="/pass-desk.js" defer></script>
</Base>
