---
import Base from '../layouts/Base.astro';
import TaleCard from '../components/TaleCard.astro';
import { getTales } from '../lib';
const tales = await getTales();
// Up to nine of the newest tales take turns in the lead slot
const leads = tales.slice(0, 9);
// "Latest tales" lists the newest tales after the first lead story
const rest = tales.slice(1);
---
<Base>
  {leads.length > 0 && (
    <section class="lead-slider" aria-roledescription="carousel" aria-label="Lead stories" data-interval="8000">
      <div class="slides">
        {leads.map((t, i) => (
          <article class={`lead slide${i === 0 ? ' is-active' : ''}`} aria-roledescription="slide" aria-label={`${i + 1} of ${leads.length}`} aria-hidden={i === 0 ? 'false' : 'true'}>
            <div>
              <div class="label kicker">{t.data.section} &middot; {i === 0 ? 'Lead story' : 'Also fresh'}</div>
              {i === 0
                ? <h1><a href={`/tales/${t.id}/`}>{t.data.title}</a></h1>
                : <h2 class="h1"><a href={`/tales/${t.id}/`} tabindex="-1">{t.data.title}</a></h2>}
              {t.data.subtitle && <p class="sub">{t.data.subtitle}</p>}
              <p style="margin-top:22px"><a class="btn dark" href={`/tales/${t.id}/`} tabindex={i === 0 ? undefined : '-1'}>Read the tale</a></p>
            </div>
            <a class="pic" href={`/tales/${t.id}/`} tabindex="-1" aria-hidden="true">
              {t.data.image ? <img src={t.data.image} alt="" loading={i === 0 ? 'eager' : 'lazy'} /> : <img class="emblem" src="/images/emblem.svg" alt="" />}
            </a>
          </article>
        ))}
      </div>
      {leads.length > 1 && (
        <div class="slider-nav">
          <button type="button" class="prev" aria-label="Previous story">&larr;</button>
          <div class="dots">
            {leads.map((t, i) => (
              <button type="button" class={`dot${i === 0 ? ' is-active' : ''}`} aria-label={`Show story ${i + 1}: ${t.data.title}`} aria-current={i === 0 ? 'true' : 'false'}>{i + 1}</button>
            ))}
          </div>
          <button type="button" class="next" aria-label="Next story">&rarr;</button>
          <span class="bar" aria-hidden="true"><span></span></span>
        </div>
      )}
    </section>
  )}

  <div class="section-head"><h2>Latest tales</h2><a href="/tales/">All tales &rarr;</a></div>
  {rest.length > 0 ? (
    <div class="cards">{rest.slice(0, 6).map((t) => <TaleCard tale={t} />)}</div>
  ) : (
    <p class="muted"><em>More tales are on their way. Team portraits, league stories and painted teams, fresh from the pitch.</em></p>
  )}

  <section class="band">
    <div>
      <h2>Want your team painted?</h2>
      <p>From freshly built rookies to a full championship roster. Painted by a coach, for coaches.</p>
    </div>
    <a class="btn" href="/painting/">Painting service</a>
  </section>
</Base>

<script>
  const root = document.querySelector<HTMLElement>('.lead-slider');
  if (root) {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.slide'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.dot'));
    const bar = root.querySelector<HTMLElement>('.bar span');
    const interval = Number(root.dataset.interval) || 8000;
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current = 0;
    let timer: number | undefined;
    let paused = false;

    const show = (n: number) => {
      current = (n + slides.length) % slides.length;
      slides.forEach((s, i) => {
        const on = i === current;
        s.classList.toggle('is-active', on);
        s.setAttribute('aria-hidden', on ? 'false' : 'true');
        s.querySelectorAll('a').forEach((a) => {
          if (!a.classList.contains('pic')) on ? a.removeAttribute('tabindex') : a.setAttribute('tabindex', '-1');
        });
      });
      dots.forEach((d, i) => {
        d.classList.toggle('is-active', i === current);
        d.setAttribute('aria-current', i === current ? 'true' : 'false');
      });
      restart();
    };

    const restart = () => {
      window.clearTimeout(timer);
      if (bar) { bar.style.transition = 'none'; bar.style.width = '0%'; }
      if (reduced || paused || slides.length < 2) return;
      if (bar) {
        void bar.offsetWidth;
        bar.style.transition = `width ${interval}ms linear`;
        bar.style.width = '100%';
      }
      timer = window.setTimeout(() => show(current + 1), interval);
    };

    root.querySelector('.prev')?.addEventListener('click', () => show(current - 1));
    root.querySelector('.next')?.addEventListener('click', () => show(current + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => show(i)));

    const pause = () => { paused = true; restart(); };
    const resume = () => { paused = false; restart(); };
    root.addEventListener('mouseenter', pause);
    root.addEventListener('mouseleave', resume);
    root.addEventListener('focusin', pause);
    root.addEventListener('focusout', resume);
    document.addEventListener('visibilitychange', () => (document.hidden ? pause() : resume()));

    // swipe on touch screens
    let x0: number | null = null;
    root.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    root.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) show(current + (dx < 0 ? 1 : -1));
      x0 = null;
    });

    restart();
  }
</script>
