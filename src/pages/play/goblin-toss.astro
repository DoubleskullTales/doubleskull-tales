---
import Base from '../../layouts/Base.astro';
---
<Base title="Goblin Toss" image="/images/play-goblin-toss.jpg" description="A winter mini game: pick a big guy, pick a stunty and throw him as far as you can. Krampusbowl weather included.">
  <div class="page gt-page">
    <p class="gt-back"><a href="/play/">← All mini games</a></p>
    <p class="gt-kicker">Mini game · Winter edition</p>
    <h1>Goblin Toss</h1>
    <p class="gt-intro"><em>One big guy, one small volunteer, one frozen pitch. Halflings and gnomes welcome too. The weather is rolled on the Krampusbowl table before every throw. How far can you go?</em></p>
    <figure class="gt-hero"><img src="/images/play-goblin-toss.jpg" alt="A troll throws a panicking goblin across a snowy pitch towards a cheering crowd." width="1200" height="670" /><figcaption>One troll, one volunteer, one very excited front row. Illustration: AI-generated.</figcaption></figure>

    <div class="gt-pickers">
      <div class="gt-pickrow"><span class="gt-l">Thrower</span>
        <button type="button" class="gt-pick" data-kind="thrower" data-id="troll" aria-pressed="true">Troll</button>
        <button type="button" class="gt-pick" data-kind="thrower" data-id="ogre" aria-pressed="false">Ogre</button>
        <button type="button" class="gt-pick" data-kind="thrower" data-id="treeman" aria-pressed="false">Treeman</button>
      </div>
      <div class="gt-pickrow"><span class="gt-l">Thrown</span>
        <button type="button" class="gt-pick" data-kind="stunty" data-id="goblin" aria-pressed="true">Goblin</button>
        <button type="button" class="gt-pick" data-kind="stunty" data-id="halfling" aria-pressed="false">Halfling</button>
        <button type="button" class="gt-pick" data-kind="stunty" data-id="gnome" aria-pressed="false">Gnome</button>
      </div>
      <p class="gt-pickinfo" id="gt-pickinfo"></p>
    </div>

    <div class="gt-hud">
      <div><span class="gt-l">Weather</span><span class="gt-v" id="gt-weather">-</span><span class="gt-s" id="gt-dice"></span></div>
      <div><span class="gt-l">Wind</span><span class="gt-v" id="gt-wind">-</span></div>
      <div><span class="gt-l">Last throw</span><span class="gt-v" id="gt-last">-</span></div>
      <div><span class="gt-l">Your best</span><span class="gt-v" id="gt-best">-</span><span class="gt-s" id="gt-bestby"></span></div>
    </div>

    <div class="gt-stage">
      <canvas id="gt-canvas" width="960" height="440" aria-label="Goblin Toss game"></canvas>
      <div class="gt-msg" id="gt-msg"></div>
    </div>
    <button class="btn dark gt-btn" id="gt-btn" type="button">Pick up the goblin</button>

    <h2>How to play</h2>
    <ul>
      <li>Pick your thrower and your volunteer. Then tap the button (or the pitch, or hit the space bar) to pick him up.</li>
      <li>Tap again to lock the <strong>angle</strong>, then once more to lock the <strong>power</strong>.</li>
      <li>Two opposing players are standing on the pitch. Hit one and he goes down: <strong>+5 squares</strong> per knockdown. But every hit costs your flyer most of his speed. Fly high for distance, or low for bodies.</li>
      <li>Watch the weather. Howling Winds blow hard, a Blizzard saps the thrower's strength, and on a Frozen Pitch your flyer keeps sliding after he lands. On Freezing ground, landing on your feet gets harder.</li>
      <li>Too little power is a fumble. And every big guy has his moments. Sometimes the little one never leaves the hand.</li>
    </ul>
    <p>Distance is measured in squares from the thrower. The crowd barrier is 30 squares away. Anything beyond that is a crowd surf, and it still counts.</p>
    <p class="gt-fine">Your best throw is saved only in this browser. Nothing is sent anywhere.</p>
    <p>Want to know what the weather really does at the Krampusbowl? Read <a href="/tales/krampusbowl-weather/">Brisk, With a Chance of Broken Ribs</a>. Rather slide than fly? Try <a href="/play/sideline-slide/">Sideline Slide</a>.</p>
  </div>

  <style>
    .gt-back { font-family: 'Inter', sans-serif; font-size: .8rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; margin: 0 0 .6em; }
    .gt-back a { text-decoration: none; }
    .gt-kicker { font-family: 'Inter', sans-serif; font-weight: 700; letter-spacing: .3em; text-transform: uppercase; font-size: .8rem; color: var(--red); }
    .gt-hero { margin: 1.2em 0 0; }
    .gt-hero img { display: block; width: 100%; height: auto; aspect-ratio: 12 / 5; object-fit: cover; border: 3px solid var(--ink); }
    .gt-hero figcaption { font-family: 'Inter', sans-serif; font-size: .78rem; color: var(--muted); margin-top: 6px; }
    .gt-intro { font-size: 1.2rem; }
    .gt-pickers { margin: 1.4em 0 0; display: flex; flex-direction: column; gap: 8px; }
    .gt-pickrow { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }
    .gt-pickrow .gt-l { width: 76px; }
    .gt-pick { font-family: 'Inter', sans-serif; font-weight: 700; font-size: .85rem; letter-spacing: .08em; text-transform: uppercase; padding: 7px 14px; border: 2.5px solid var(--ink); background: transparent; color: var(--ink); cursor: pointer; }
    .gt-pick[aria-pressed="true"] { background: var(--ink); color: var(--paper, #efe6d2); }
    .gt-pick:disabled { opacity: .45; cursor: not-allowed; }
    .gt-pickinfo { font-family: 'Inter', sans-serif; font-size: .8rem; color: var(--muted); margin: 2px 0 0; }
    .gt-hud { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border: 3px solid var(--ink); margin: 1em 0 0; font-family: 'Inter', sans-serif; }
    .gt-hud > div { padding: 10px 12px; border-right: 2px solid var(--ink); display: flex; flex-direction: column; gap: 2px; }
    .gt-hud > div:last-child { border-right: none; }
    .gt-l { font-family: 'Inter', sans-serif; font-size: .68rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--muted); }
    .gt-v { font-family: 'Anton', sans-serif; font-size: 1.35rem; text-transform: uppercase; line-height: 1.1; }
    .gt-s { font-size: .75rem; color: var(--muted); }
    .gt-stage { position: relative; border: 3px solid var(--ink); border-top: none; background: #dfe8ee; }
    #gt-canvas { display: block; width: 100%; height: auto; touch-action: manipulation; cursor: pointer; }
    .gt-msg { position: absolute; left: 50%; top: 12%; transform: translateX(-50%); width: 86%; text-align: center; font-family: 'Anton', sans-serif; text-transform: uppercase; font-size: clamp(1.2rem, 3.6vw, 2.2rem); line-height: 1.05; color: var(--ink); text-shadow: 0 0 6px #f4f1ea, 0 0 12px #f4f1ea; pointer-events: none; }
    .gt-msg :global(small) { display: block; font-family: 'Crimson Text', serif; font-style: italic; text-transform: none; font-size: .6em; margin-top: 6px; }
    .gt-btn { display: block; width: 100%; margin-top: 12px; font-size: 1.05rem; padding: 14px; cursor: pointer; }
    .gt-fine { font-family: 'Inter', sans-serif; font-size: .8rem; color: var(--muted); }
    @media (max-width: 560px) {
      .gt-hud { grid-template-columns: 1fr 1fr; }
      .gt-hud > div:nth-child(2) { border-right: none; }
      .gt-hud > div:nth-child(-n+2) { border-bottom: 2px solid var(--ink); }
      .gt-pick { padding: 6px 10px; font-size: .78rem; }
    }
  </style>

  <script is:inline>
  (function () {
    const cv = document.getElementById('gt-canvas');
    const ctx = cv.getContext('2d');
    const W = 960, H = 440, GROUND = 370, SQ = 30, ORIGIN = 150, BARRIER = 30, BONUS = 5;
    const X0 = ORIGIN - 30;
    const INK = '#1b1712', RED = '#9b1c1c', PAPER = '#efe6d2';
    const AIM_ANG = -2.45, REL_ANG = -0.75;
    const $ = (id) => document.getElementById(id);
    const btn = $('gt-btn'), msg = $('gt-msg');

    const THROWERS = {
      troll: { name: 'Troll', power: 1, sx: -22, sy: -112, len: 64, angleSpeed: 3.6, powerSpeed: 5.2, eats: true,
        info: 'Strong arm. Always Hungry.', quirk: (s) => ['Always Hungry!', 'The troll ate the ' + s + '. Find another volunteer.'] },
      ogre: { name: 'Ogre', power: .95, sx: -20, sy: -108, len: 58, angleSpeed: 3.6, powerSpeed: 4.2,
        info: 'Slower power bar, a bit less strength. Bone Head.', quirk: (s) => ['Bone Head!', 'The ogre forgot what he was holding. The ' + s + ' waits politely.'] },
      treeman: { name: 'Treeman', power: .93, sx: -14, sy: -150, len: 62, angleSpeed: 2.9, powerSpeed: 5.6,
        info: 'Very tall release, slow and steady aim. Takes root now and then.', quirk: (s) => ['Take Root!', 'The treeman will not move today. Neither will the ' + s + '.'] },
    };
    const STUNTIES = {
      goblin: { name: 'goblin', dist: 1.05, feet: 4 / 6, hit: 1, info: 'Light. Flies furthest.' },
      halfling: { name: 'halfling', dist: .95, feet: 4 / 6, hit: 1.4, info: 'Heavier, but a much bigger target to hit with.' },
      gnome: { name: 'gnome', dist: 1, feet: 5 / 6, hit: 1, info: 'Lands on his feet more often than the others.' },
    };
    let sel = { thrower: 'troll', stunty: 'goblin' };
    const T = () => THROWERS[sel.thrower], S = () => STUNTIES[sel.stunty];
    const shoulder = () => ({ x: X0 + T().sx, y: GROUND + T().sy });
    const handAt = (ang, len) => { const s = shoulder(); return { x: s.x + Math.cos(ang) * len, y: s.y + Math.sin(ang) * len }; };

    function fit() {
      const r = Math.min(window.devicePixelRatio || 1, 2);
      cv.width = W * r; cv.height = H * r; ctx.setTransform(r, 0, 0, r, 0, 0);
    }
    fit(); window.addEventListener('resize', fit);

    // Best score (local only)
    let best = null, bestBy = '';
    try {
      const b = parseFloat(localStorage.getItem('dst-goblin-toss-best')); if (!isNaN(b)) best = b;
      bestBy = localStorage.getItem('dst-goblin-toss-best-by') || '';
    } catch (e) {}
    const fmt = (d) => d.toFixed(1) + ' sq';
    function showBest() { $('gt-best').textContent = best != null ? fmt(best) : '-'; $('gt-bestby').textContent = bestBy; }
    showBest();

    // Weather (Krampusbowl table)
    const d6 = () => 1 + Math.floor(Math.random() * 6);
    function rollWeather() {
      const a = d6(), b = d6(), s = a + b;
      let w;
      if (s === 2) w = { name: 'Howling Winds', wind: (Math.random() < .5 ? -1 : 1) * (3 + Math.random() * 1.5), snow: 60, power: 1 };
      else if (s === 3) w = { name: 'Freezing', wind: (Math.random() * 2 - 1) * 1.2, snow: 40, power: 1, freezing: true };
      else if (s === 11) w = { name: 'Frozen Pitch', wind: (Math.random() * 2 - 1) * 1.2, snow: 30, power: 1, slide: true };
      else if (s === 12) w = { name: 'Blizzard', wind: (Math.random() * 2 - 1) * 2, snow: 260, power: .85 };
      else w = { name: 'Brisk', wind: (Math.random() * 2 - 1) * 1.2, snow: 35, power: 1 };
      w.dice = a + ' + ' + b + ' = ' + s;
      return w;
    }
    function showWeather(w) {
      $('gt-weather').textContent = w.name;
      $('gt-dice').textContent = '2D6: ' + w.dice;
      const v = Math.abs(w.wind);
      $('gt-wind').textContent = v < .3 ? 'Calm' : (w.wind > 0 ? '→ ' : '← ') + v.toFixed(1);
    }

    let flakes = [];
    function setSnow(n) { flakes = Array.from({ length: n }, () => ({ x: Math.random() * W, y: Math.random() * H, r: .8 + Math.random() * 2.2, s: 20 + Math.random() * 40 })); }

    function placeOpps() {
      const xs = [];
      while (xs.length < 2) {
        const sq = 8 + Math.random() * 19;
        if (xs.every((o) => Math.abs(o - sq) > 5)) xs.push(sq);
      }
      return xs.map((sq) => ({ x: ORIGIN + sq * SQ, down: false, t: 0 }));
    }

    // State: ready, angle, power, fly, eat, done
    let state = 'ready', weather = rollWeather(), t0 = 0, angle = 0, power = 0;
    let gob = null, cam = 0, swing = 0, opps = placeOpps(), hits = 0, eaten = false, eatT = 0, chew = 0;
    showWeather(weather); setSnow(weather.snow);

    function say(main, sub) { msg.innerHTML = main ? main + (sub ? '<small>' + sub + '</small>' : '') : ''; }
    function idleText() { say('Tap to pick up the ' + S().name, 'Then lock angle and power'); btn.textContent = 'Pick up the ' + S().name; }
    function pickInfo() { $('gt-pickinfo').textContent = T().name + ': ' + T().info + ' ' + S().name.charAt(0).toUpperCase() + S().name.slice(1) + ': ' + S().info; }
    idleText(); pickInfo();

    const picks = document.querySelectorAll('.gt-pick');
    picks.forEach((b) => b.addEventListener('click', () => {
      if (state !== 'ready' && state !== 'done') return;
      sel[b.dataset.kind] = b.dataset.id;
      picks.forEach((o) => { if (o.dataset.kind === b.dataset.kind) o.setAttribute('aria-pressed', String(o === b)); });
      pickInfo();
      if (state === 'ready') idleText();
    }));
    const lockPicks = (on) => picks.forEach((b) => { b.disabled = on; });

    function verdict(d, crowd) {
      if (crowd) return 'Crowd surf! The fans will throw him back. Eventually.';
      if (d < 3) return 'A gentle lob. The ' + S().name + ' is mildly offended.';
      if (d < 12) return 'Respectable. The coach nods once.';
      if (d < 20) return 'Proper Throw Team-mate distance.';
      if (d < 26) return 'That ' + S().name + ' has seen the clouds.';
      return 'Almost into the stands. The front row ducks.';
    }

    function act() {
      const now = performance.now();
      if (state === 'ready' || state === 'done') {
        if (state === 'done') { weather = rollWeather(); showWeather(weather); setSnow(weather.snow); opps = placeOpps(); }
        gob = null; cam = 0; swing = 0; hits = 0; eaten = false; chew = 0;
        state = 'angle'; t0 = now; say(''); btn.textContent = 'Lock the angle'; lockPicks(true);
      } else if (state === 'angle') {
        state = 'power'; t0 = now; btn.textContent = 'Lock the power';
      } else if (state === 'power') {
        if (Math.random() < 1 / 15) {
          if (T().eats) { state = 'eat'; eatT = 0; btn.disabled = true; btn.textContent = 'Uh oh...'; return; }
          state = 'done'; const q = T().quirk(S().name); finish(0, true, q[0], q[1]); return;
        }
        if (power < .15) {
          gob = { x: ORIGIN + 14, y: GROUND - 9, vx: 0, vy: 0, rot: 0, landed: true, sliding: false, feet: false };
          state = 'done'; finish(Math.max(0, (gob.x - ORIGIN) / SQ), false, 'Fumble!', 'Not enough power. The ' + S().name + ' lands at the thrower\'s feet.');
          return;
        }
        const v = 700 * (.35 + .65 * power) * weather.power * T().power * S().dist;
        const a = angle * Math.PI / 180, r = handAt(REL_ANG, T().len);
        gob = { x: r.x, y: r.y - 10, vx: v * Math.cos(a), vy: -v * Math.sin(a), rot: 0, landed: false, sliding: false, feet: false };
        state = 'fly'; swing = 1; btn.textContent = 'Flying...'; btn.disabled = true;
      }
    }

    function finish(d, quirk, title, sub) {
      btn.disabled = false; lockPicks(false); btn.textContent = 'Throw again';
      const total = d + hits * BONUS;
      $('gt-last').textContent = quirk ? 'No throw' : fmt(total);
      if (!quirk && total > 0.5 && (best == null || total > best)) {
        best = total; bestBy = T().name + ' + ' + S().name;
        try { localStorage.setItem('dst-goblin-toss-best', String(best)); localStorage.setItem('dst-goblin-toss-best-by', bestBy); } catch (e) {}
        showBest(); sub = (sub ? sub + ' ' : '') + 'New personal best!';
      }
      say(title, sub);
    }

    btn.addEventListener('click', act);
    cv.addEventListener('pointerdown', (e) => { e.preventDefault(); if (!btn.disabled) act(); });
    window.addEventListener('keydown', (e) => {
      if (e.code === 'Space' && !(document.activeElement && document.activeElement.tagName === 'BUTTON')) {
        const r = cv.getBoundingClientRect();
        if (r.bottom > 0 && r.top < window.innerHeight) { e.preventDefault(); if (!btn.disabled) act(); }
      }
    });

    // Physics
    const G = 600;
    const FEET_Y = GROUND - 23, BELLY_Y = GROUND - 9;
    function knock(o) {
      o.down = true; o.t = 0; hits++;
      gob.vx *= .3; if (!gob.landed) gob.vy = Math.min(gob.vy, -140);
    }
    function update(dt) {
      const now = performance.now();
      if (state === 'angle') angle = 45 + 32 * Math.sin((now - t0) / 1000 * T().angleSpeed - Math.PI / 2);
      if (state === 'power') power = .5 - .5 * Math.cos((now - t0) / 1000 * T().powerSpeed);
      if (state === 'fly' || state === 'done') swing = Math.max(0, swing - dt * 2.5);
      for (const o of opps) if (o.down) o.t += dt;
      if (state === 'eat') {
        eatT += dt;
        if (eatT > .9) chew += dt;
        if (eatT > 2.6) { eaten = true; state = 'done'; const q = T().quirk(S().name); finish(0, true, q[0], q[1]); }
      }
      if (state === 'fly' && gob) {
        const hitR = 16 * S().hit;
        if (!gob.landed) {
          gob.vx += weather.wind * 40 * dt;
          gob.vy += G * dt;
          gob.x += gob.vx * dt; gob.y += gob.vy * dt;
          gob.rot += dt * 8 * Math.sign(gob.vx || 1);
          for (const o of opps) if (!o.down && Math.abs(gob.x - o.x) < hitR && gob.y > GROUND - 78) knock(o);
          if (gob.y >= GROUND - 12) {
            const chance = S().feet - (weather.freezing ? 1 / 6 : 0);
            gob.feet = Math.random() < chance;
            gob.landed = true; gob.y = gob.feet ? FEET_Y : BELLY_Y; gob.squash = 1;
            if (weather.slide && gob.x < ORIGIN + BARRIER * SQ && Math.abs(gob.vx) > 5) { gob.sliding = true; gob.vx = Math.max(60, Math.abs(gob.vx) * .55) * Math.sign(gob.vx || 1); }
          }
        } else if (gob.sliding) {
          gob.x += gob.vx * dt;
          gob.vx *= Math.pow(.25, dt);
          for (const o of opps) if (!o.down && Math.abs(gob.x - o.x) < hitR) knock(o);
          if (Math.abs(gob.vx) < 12) gob.sliding = false;
        }
        if (gob.squash) gob.squash = Math.max(0, gob.squash - dt * 4);
        if (gob.landed && !gob.sliding) {
          state = 'done';
          const d = Math.max(0, (gob.x - ORIGIN) / SQ);
          const crowd = d >= BARRIER;
          let sub = verdict(d, crowd);
          if (!crowd) sub += gob.feet ? ' Landed on his feet!' : (weather.freezing ? ' Splat, on granite-hard ice.' : ' Splat. He\'ll be fine. Probably.');
          if (weather.slide && !crowd) sub += ' The ice added a few squares.';
          let title = fmt(d).replace('sq', 'squares');
          if (hits) { title = d.toFixed(1) + ' + ' + (hits * BONUS) + ' = ' + (d + hits * BONUS).toFixed(1); sub = (hits === 2 ? 'Two players flattened!' : 'Opponent flattened!') + ' +' + (hits * BONUS) + ' squares. ' + sub; }
          finish(d, false, title, sub);
        }
        const target = gob.x - 330;
        cam += (Math.max(0, target) - cam) * Math.min(1, dt * 6);
      } else if (state !== 'done') {
        cam += (0 - cam) * Math.min(1, dt * 4);
      }
      for (const f of flakes) {
        f.y += f.s * dt; f.x += (weather.wind * 18 + Math.sin(f.y / 30) * 6) * dt;
        if (f.y > H) { f.y = -4; f.x = Math.random() * W; }
        if (f.x > W) f.x -= W; if (f.x < 0) f.x += W;
      }
    }

    // Drawing helpers
    function line(x1, y1, x2, y2, w, c) { ctx.strokeStyle = c || INK; ctx.lineWidth = w; ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke(); }
    function ell(x, y, rx, ry, fill, w, rot) { ctx.beginPath(); ctx.ellipse(x, y, rx, ry, rot || 0, 0, Math.PI * 2); ctx.fillStyle = fill; ctx.fill(); ctx.lineWidth = w || 3; ctx.strokeStyle = INK; ctx.stroke(); }
    function poly(pts, fill, w) { ctx.beginPath(); ctx.moveTo(pts[0], pts[1]); for (let i = 2; i < pts.length; i += 2) ctx.lineTo(pts[i], pts[i + 1]); ctx.closePath(); ctx.fillStyle = fill; ctx.fill(); ctx.lineWidth = w || 2.5; ctx.strokeStyle = INK; ctx.stroke(); }
    const lerp = (a, b, t) => a + (b - a) * Math.max(0, Math.min(1, t));

    function drawStands(off) {
      for (let i = -1; i < 8; i++) {
        const x = i * 260 - (off * .3) % 260;
        ctx.fillStyle = '#b9b0a2'; ctx.fillRect(x, 175, 240, 120);
        ctx.fillStyle = '#a89d8d'; for (let r = 0; r < 4; r++) ctx.fillRect(x, 195 + r * 26, 240, 6);
        ctx.fillStyle = '#8f8476'; ctx.fillRect(x - 4, 165, 248, 12);
      }
    }

    // Throwing arm (the far arm, drawn behind the body)
    function throwArm() {
      let ang = AIM_ANG, len = T().len;
      if (state === 'fly' || (state === 'done' && gob)) ang = REL_ANG + (1 - swing) * 1.7;
      if (state === 'eat') {
        const m = mouth(), s = shoulder();
        const ma = Math.atan2(m.y - s.y, m.x - s.x), ml = Math.hypot(m.x - s.x, m.y - s.y);
        const k = Math.min(1, eatT / .7);
        ang = lerp(AIM_ANG, ma, k); len = lerp(T().len, ml, k);
      }
      if (state === 'done' && eaten) { const m = mouth(), s = shoulder(); ang = Math.atan2(m.y - s.y, m.x - s.x) + .9; len = T().len * .8; }
      return { ang, len };
    }
    function drawArmShape(ang, len, w, col) {
      const s = shoulder(), e = { x: s.x + Math.cos(ang) * len, y: s.y + Math.sin(ang) * len };
      ctx.lineCap = 'round'; line(s.x, s.y, e.x, e.y, w + 7, INK); line(s.x, s.y, e.x, e.y, w, col); ctx.lineCap = 'butt';
      ell(e.x, e.y, w * .75, w * .65, col, 3);
      return e;
    }
    const armFront = () => state === 'fly' || state === 'eat' || (state === 'done' && (gob || eaten));
    function mouth() { return { x: X0 + 40, y: GROUND - 118 }; }

    function drawTroll() {
      const x = X0, y = GROUND, skin = '#7f8f6b', dark = '#66755a', belly = '#a7b48f';
      const a = throwArm(), front = armFront();
      let hand = front ? null : drawArmShape(a.ang, a.len, 17, dark);
      // legs and feet
      ctx.fillStyle = skin; ctx.strokeStyle = INK; ctx.lineWidth = 3;
      poly([x - 26, y - 50, x - 8, y - 50, x - 6, y - 10, x - 28, y - 10], skin, 3);
      poly([x + 6, y - 50, x + 24, y - 50, x + 26, y - 10, x + 4, y - 10], skin, 3);
      ell(x - 18, y - 7, 18, 8, dark); ell(x + 18, y - 7, 18, 8, dark);
      // hunched torso
      ell(x, y - 82, 44, 50, skin, 3.5, -.35);
      ell(x + 8, y - 72, 22, 28, belly, 0, -.3);
      for (const [wx, wy] of [[-24, -100], [-10, -118], [-30, -72], [12, -110]]) ell(x + wx, y + wy, 3, 3, dark, 1.5);
      // loincloth
      poly([x - 30, y - 52, x + 28, y - 46, x + 18, y - 24, x - 20, y - 26], '#6b4f32', 2.5);
      // head (forward and low)
      const cj = state === 'eat' && eatT > .9 ? Math.abs(Math.sin(chew * 14)) * 7 : (state === 'eat' && eatT > .45 ? 9 : 0);
      ell(x + 26, y - 128, 20, 16, skin, 3);
      poly([x + 14, y - 136, x + 4, y - 150, x + 18, y - 140], skin, 2.5);
      ell(x + 32, y - 112 + cj, 20, 10, skin, 3);
      poly([x + 22, y - 116 + cj, x + 25, y - 128 + cj, x + 29, y - 116 + cj], '#f4f1ea', 2);
      poly([x + 40, y - 116 + cj, x + 43, y - 127 + cj, x + 47, y - 116 + cj], '#f4f1ea', 2);
      line(x + 26, y - 138, x + 44, y - 134, 4);
      ell(x + 36, y - 131, 2.8, 2.8, '#e8d36a', 1.5);
      ell(x + 44, y - 125, 5, 4, dark, 2);
      // near arm: long, hanging, knuckles almost on the ground
      ctx.lineCap = 'round'; line(x + 14, y - 104, x + 34, y - 30, 24, INK); line(x + 14, y - 104, x + 34, y - 30, 17, skin); ctx.lineCap = 'butt';
      ell(x + 36, y - 24, 12, 10, skin, 3);
      if (front) hand = drawArmShape(a.ang, a.len, 17, dark);
      return hand;
    }

    function drawOgre() {
      const x = X0, y = GROUND, skin = '#c79a6b';
      const a = throwArm(), front = armFront();
      let hand = front ? null : drawArmShape(a.ang, a.len, 17, '#b5885c');
      ctx.fillStyle = '#5a4630'; ctx.fillRect(x - 26, y - 34, 18, 30); ctx.fillRect(x + 8, y - 34, 18, 30);
      ell(x - 17, y - 6, 15, 8, '#5a4630'); ell(x + 17, y - 6, 15, 8, '#5a4630');
      ell(x, y - 74, 44, 50, skin, 3.5);
      ctx.fillStyle = '#6b4f32'; ctx.fillRect(x - 40, y - 46, 80, 14); line(x - 40, y - 46, x + 40, y - 46, 2.5); line(x - 40, y - 32, x + 40, y - 32, 2.5);
      ell(x + 6, y - 132, 17, 16, skin); ell(x + 12, y - 135, 2.6, 2.6, INK, 1); line(x + 8, y - 124, x + 20, y - 126, 3);
      ell(x + 2, y - 152, 6, 7, INK, 1);
      ctx.lineCap = 'round'; line(x + 26, y - 100, x + 40, y - 52, 24, INK); line(x + 26, y - 100, x + 40, y - 52, 17, skin); ctx.lineCap = 'butt';
      ell(x + 41, y - 46, 11, 10, skin, 3);
      if (front) hand = drawArmShape(a.ang, a.len, 17, '#b5885c');
      return hand;
    }

    function drawTreeman() {
      const x = X0, y = GROUND;
      const a = throwArm(), front = armFront();
      let hand = front ? null : drawArmShape(a.ang, a.len, 11, '#5a4128');
      poly([x - 28, y, x - 22, y - 170, x + 22, y - 170, x + 30, y], '#6b4f32', 3.5);
      line(x - 30, y, x - 44, y, 4); line(x + 30, y, x + 44, y, 4);
      for (let i = 0; i < 5; i++) line(x - 14 + i * 7, y - 160 + (i % 2) * 20, x - 12 + i * 7, y - 20 - (i % 3) * 20, 1.5, '#3d2c1c');
      ell(x + 6, y - 140, 4, 4, '#e8d36a', 1.5); ell(x - 8, y - 140, 4, 4, '#e8d36a', 1.5);
      ell(x - 26, y - 186, 22, 18, '#4f7a3a'); ell(x + 2, y - 196, 26, 20, '#5d8a42'); ell(x + 28, y - 184, 20, 16, '#4f7a3a');
      ctx.lineCap = 'round'; line(x + 18, y - 120, x + 40, y - 70, 15, INK); line(x + 18, y - 120, x + 40, y - 70, 9, '#6b4f32'); ctx.lineCap = 'butt';
      if (front) hand = drawArmShape(a.ang, a.len, 11, '#5a4128');
      return hand;
    }

    function drawStunty(x, y, rot, scared, squash, scale) {
      const k = sel.stunty, sc = 1.35 * (scale == null ? 1 : scale);
      ctx.save(); ctx.translate(x, y); ctx.rotate(rot); ctx.scale(sc * (1 + (squash || 0) * .25), sc * (1 - (squash || 0) * .2));
      // legs and feet (soles at local y = 16)
      const shoe = k === 'halfling' ? '#efc9a0' : (k === 'gnome' ? '#6b4f32' : '#7fa257');
      line(-3, 4, -4, 13, 3.4); line(3, 4, 4, 13, 3.4);
      ell(-2, 14.5, 4.6, 2.4, shoe, 1.8); ell(6, 14.5, 4.6, 2.4, shoe, 1.8);
      ctx.translate(0, -5);
      if (k === 'goblin') {
        ell(0, 3, 8, 8, '#7a5a3a', 2.5);
        poly([-8, -12, -22, -20, -7, -6], '#7fa257'); poly([8, -12, 22, -20, 7, -6], '#7fa257');
        ell(0, -10, 9, 9, '#7fa257', 2.5);
      } else if (k === 'halfling') {
        ell(0, 3, 10, 9, '#4f6f8f', 2.5);
        ell(0, -10, 9, 9, '#efc9a0', 2.5);
        ctx.fillStyle = '#7a4a24'; ctx.beginPath(); ctx.arc(0, -13, 9, Math.PI, 0); ctx.fill(); ctx.lineWidth = 2; ctx.strokeStyle = INK; ctx.stroke();
      } else {
        ell(0, 3, 8, 8, '#4a6b4a', 2.5);
        ell(0, -9, 8, 8, '#efc9a0', 2.5);
        poly([-8, -13, 8, -13, 3, -32], RED);
        ctx.fillStyle = '#f4f1ea'; ctx.beginPath(); ctx.moveTo(-6, -5); ctx.quadraticCurveTo(0, 8, 6, -5); ctx.closePath(); ctx.fill(); ctx.lineWidth = 1.5; ctx.strokeStyle = INK; ctx.stroke();
      }
      const e = scared ? 2.6 : 1.6;
      ell(-3, -11, e, e, '#fff', 1); ell(4, -11, e, e, '#fff', 1);
      if (k !== 'gnome') line(-4, -4, 4, -4, 2);
      ctx.restore();
    }

    function drawOpp(o) {
      ctx.save(); ctx.translate(o.x, GROUND);
      if (o.down) ctx.rotate(-Math.min(1, o.t * 6) * 1.5);
      line(-6, -26, -7, -4, 5); line(6, -26, 7, -4, 5);
      ell(-9, -3, 6, 3, INK, 1); ell(9, -3, 6, 3, INK, 1);
      ell(0, -42, 13, 18, '#2e5a33', 2.5);
      ell(-13, -54, 8, 6, '#a8833a', 2); ell(13, -54, 8, 6, '#a8833a', 2);
      ell(0, -66, 9, 9, '#efc9a0', 2.5);
      ctx.fillStyle = '#2e5a33'; ctx.beginPath(); ctx.arc(0, -68, 10, Math.PI, 0); ctx.fill(); ctx.lineWidth = 2.5; ctx.strokeStyle = INK; ctx.stroke();
      ctx.restore();
      if (o.down) {
        ctx.font = '700 16px Inter, sans-serif'; ctx.fillStyle = '#a8833a'; ctx.textAlign = 'center';
        const tt = performance.now() / 300;
        for (let i = 0; i < 3; i++) ctx.fillText('✦', o.x - 50 + Math.cos(tt + i * 2.1) * 14, GROUND - 22 + Math.sin(tt + i * 2.1) * 5);
      }
    }

    function draw() {
      const g = ctx.createLinearGradient(0, 0, 0, GROUND);
      g.addColorStop(0, '#cfdbe3'); g.addColorStop(1, '#eef0ee');
      ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
      drawStands(cam);

      ctx.save(); ctx.translate(-cam, 0);
      ctx.fillStyle = '#f6f7f8'; ctx.fillRect(cam - 10, GROUND, W + 20, H - GROUND);
      line(cam - 10, GROUND, cam + W + 10, GROUND, 3);
      ctx.font = '600 13px Inter, sans-serif'; ctx.textAlign = 'center'; ctx.fillStyle = '#7a8590';
      for (let i = 0; i <= 60; i++) {
        const x = ORIGIN + i * SQ;
        if (x < cam - 40 || x > cam + W + 40) continue;
        line(x, GROUND + 2, x, H, i % 5 === 0 ? 2 : 1, i % 5 === 0 ? '#9aa6b0' : '#d3dae0');
        if (i % 5 === 0 && i > 0 && i < BARRIER) ctx.fillText(String(i), x, H - 14);
      }
      if (weather.slide) { ctx.fillStyle = 'rgba(140,190,230,.25)'; ctx.fillRect(cam - 10, GROUND + 3, W + 20, H - GROUND); }
      const bx = ORIGIN + BARRIER * SQ;
      ctx.fillStyle = '#6b4f32'; ctx.fillRect(bx, GROUND - 48, 900, 48);
      line(bx, GROUND - 48, bx + 900, GROUND - 48, 3); line(bx, GROUND - 48, bx, GROUND, 3);
      const cols = ['#9b1c1c', '#2e5a33', '#a8833a', '#4a5a6a'];
      for (let i = 0; i < 24; i++) {
        const fx = bx + 20 + i * 36, bob = Math.sin(performance.now() / 300 + i) * 2;
        ell(fx, GROUND - 58 + bob, 13, 16, cols[i % 4], 2.5);
        ell(fx, GROUND - 82 + bob, 9, 9, '#e2c3a0', 2.5);
        ctx.fillStyle = cols[(i + 1) % 4]; ctx.fillRect(fx - 9, GROUND - 92 + bob, 18, 6);
      }
      for (const o of opps) drawOpp(o);

      const hand = sel.thrower === 'troll' ? drawTroll() : sel.thrower === 'ogre' ? drawOgre() : drawTreeman();
      // stunty in hand
      const holding = state === 'ready' || state === 'angle' || state === 'power' || (state === 'done' && !gob && !eaten);
      if (holding) drawStunty(hand.x, hand.y - 14, state === 'ready' || state === 'done' ? 0 : -.3, state === 'angle' || state === 'power');
      if (state === 'eat') {
        const k = eatT < .7 ? 1 : Math.max(0, 1 - (eatT - .7) / .25);
        if (k > 0) drawStunty(hand.x, hand.y - 10 * k, -.6 - (1 - k) * 2, true, 0, k);
        if (eatT > .95 && eatT < 2.4) {
          ctx.fillStyle = '#7a5a3a';
          for (let i = 0; i < 3; i++) { const p = ((eatT * 2 + i * .33) % 1); ctx.beginPath(); ctx.arc(X0 + 52 + i * 5, GROUND - 108 + p * 60, 2, 0, Math.PI * 2); ctx.fill(); }
        }
        if (eatT > 2.1) { ctx.font = '400 26px Anton, sans-serif'; ctx.textAlign = 'left'; ctx.fillStyle = INK; ctx.fillText('BURP', X0 + 64, GROUND - 150 - (eatT - 2.1) * 30); }
      }
      if (gob) {
        const r = gob.landed ? (gob.feet ? 0 : 1.5 * Math.sign(gob.vx || 1)) : gob.rot;
        drawStunty(gob.x, gob.y, r, true, gob.landed && gob.feet ? gob.squash : 0);
        if (gob.y < 6) {
          ctx.fillStyle = RED; ctx.beginPath(); ctx.moveTo(gob.x, 8); ctx.lineTo(gob.x - 9, 24); ctx.lineTo(gob.x + 9, 24); ctx.closePath(); ctx.fill();
          ctx.font = '700 12px Inter, sans-serif'; ctx.textAlign = 'center'; ctx.fillStyle = INK; ctx.fillText('way up there', gob.x, 40);
        }
      }

      if (state === 'angle' || state === 'power') {
        const a = angle * Math.PI / 180, o = handAt(REL_ANG, T().len), L = 110;
        ctx.setLineDash([8, 7]); line(o.x, o.y, o.x + Math.cos(a) * L, o.y - Math.sin(a) * L, 3, RED); ctx.setLineDash([]);
        const tx = o.x + Math.cos(a) * L, ty = o.y - Math.sin(a) * L;
        ctx.fillStyle = RED; ctx.beginPath(); ctx.arc(tx, ty, 6, 0, Math.PI * 2); ctx.fill();
        ctx.font = '700 15px Inter, sans-serif'; ctx.fillStyle = INK; ctx.textAlign = 'left';
        ctx.fillText(Math.round(angle) + '°', tx + 10, ty - 6);
      }
      if (state === 'power') {
        const px = ORIGIN + 90, py = GROUND - 190, ph = 150;
        ctx.fillStyle = PAPER; ctx.fillRect(px, py, 22, ph);
        const grd = ctx.createLinearGradient(0, py + ph, 0, py);
        grd.addColorStop(0, '#a8833a'); grd.addColorStop(1, RED);
        ctx.fillStyle = grd; ctx.fillRect(px, py + ph * (1 - power), 22, ph * power);
        ctx.lineWidth = 3; ctx.strokeStyle = INK; ctx.strokeRect(px, py, 22, ph);
        line(px - 4, py + ph * .85, px + 26, py + ph * .85, 2, INK);
      }
      ctx.restore();

      ctx.fillStyle = 'rgba(255,255,255,.9)';
      for (const f of flakes) { ctx.beginPath(); ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2); ctx.fill(); }
      if (weather.name === 'Blizzard') { ctx.fillStyle = 'rgba(240,244,248,.15)'; ctx.fillRect(0, 0, W, H); }

      if (gob) {
        const d = Math.max(0, (gob.x - ORIGIN) / SQ);
        ctx.font = '400 30px Anton, sans-serif'; ctx.textAlign = 'right'; ctx.fillStyle = INK;
        ctx.fillText(d.toFixed(1) + ' SQ' + (hits ? '  +' + hits * BONUS : ''), W - 20, 44);
      }
    }

    let last = performance.now();
    function loop(now) {
      const dt = Math.min(.05, (now - last) / 1000); last = now;
      update(dt); draw();
      requestAnimationFrame(loop);
    }
    (document.fonts ? document.fonts.ready : Promise.resolve()).then(() => requestAnimationFrame(loop));
  })();
  </script>
