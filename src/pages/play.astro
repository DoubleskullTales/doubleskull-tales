---
import Base from '../layouts/Base.astro';
---
<Base title="Goblin Toss" description="A winter mini game: throw a goblin as far as you can. Krampusbowl weather included.">
  <div class="page gt-page">
    <p class="gt-kicker">Mini game · Winter edition</p>
    <h1>Goblin Toss</h1>
    <p class="gt-intro"><em>One troll, one goblin, one frozen pitch. The weather is rolled on the Krampusbowl table before every throw. How far can you go?</em></p>

    <div class="gt-hud">
      <div><span class="gt-l">Weather</span><span class="gt-v" id="gt-weather">-</span><span class="gt-s" id="gt-dice"></span></div>
      <div><span class="gt-l">Wind</span><span class="gt-v" id="gt-wind">-</span></div>
      <div><span class="gt-l">Last throw</span><span class="gt-v" id="gt-last">-</span></div>
      <div><span class="gt-l">Your best</span><span class="gt-v" id="gt-best">-</span></div>
    </div>

    <div class="gt-stage">
      <canvas id="gt-canvas" width="960" height="440" aria-label="Goblin Toss game"></canvas>
      <div class="gt-msg" id="gt-msg"></div>
    </div>
    <button class="btn dark gt-btn" id="gt-btn" type="button">Pick up the goblin</button>

    <h2>How to play</h2>
    <ul>
      <li>Tap the button (or the pitch, or hit the space bar) to pick up a goblin.</li>
      <li>Tap again to lock the <strong>angle</strong>, then once more to lock the <strong>power</strong>.</li>
      <li>Watch the wind. Howling Winds blow hard, a Blizzard saps the troll's strength, and on a Frozen Pitch your goblin keeps sliding after he lands.</li>
      <li>Too little power is a fumble. And trolls are Always Hungry. Sometimes the goblin never leaves the hand.</li>
    </ul>
    <p>Distance is measured in squares from the troll. The crowd barrier is 30 squares away. Anything beyond that is a crowd surf, and it still counts.</p>
    <p class="gt-fine">Your best throw is saved only in this browser. Nothing is sent anywhere.</p>
    <p>Want to know what the weather really does at the Krampusbowl? Read <a href="/tales/krampusbowl-weather/">Brisk, With a Chance of Broken Ribs</a>.</p>
  </div>

  <style>
    .gt-kicker { font-family: 'Inter', sans-serif; font-weight: 700; letter-spacing: .3em; text-transform: uppercase; font-size: .8rem; color: var(--red); }
    .gt-intro { font-size: 1.2rem; }
    .gt-hud { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; border: 3px solid var(--ink); margin: 1.4em 0 0; font-family: 'Inter', sans-serif; }
    .gt-hud > div { padding: 10px 12px; border-right: 2px solid var(--ink); display: flex; flex-direction: column; gap: 2px; }
    .gt-hud > div:last-child { border-right: none; }
    .gt-l { font-size: .68rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--muted); }
    .gt-v { font-family: 'Anton', sans-serif; font-size: 1.35rem; text-transform: uppercase; line-height: 1.1; }
    .gt-s { font-size: .75rem; color: var(--muted); }
    .gt-stage { position: relative; border: 3px solid var(--ink); border-top: none; background: #dfe8ee; }
    #gt-canvas { display: block; width: 100%; height: auto; touch-action: manipulation; cursor: pointer; }
    .gt-msg { position: absolute; left: 50%; top: 14%; transform: translateX(-50%); width: 86%; text-align: center; font-family: 'Anton', sans-serif; text-transform: uppercase; font-size: clamp(1.2rem, 3.6vw, 2.2rem); line-height: 1.05; color: var(--ink); text-shadow: 0 0 6px #f4f1ea, 0 0 12px #f4f1ea; pointer-events: none; }
    .gt-msg small { display: block; font-family: 'Crimson Text', serif; font-style: italic; text-transform: none; font-size: .6em; margin-top: 6px; }
    .gt-btn { display: block; width: 100%; margin-top: 12px; font-size: 1.05rem; padding: 14px; cursor: pointer; }
    .gt-fine { font-family: 'Inter', sans-serif; font-size: .8rem; color: var(--muted); }
    @media (max-width: 560px) {
      .gt-hud { grid-template-columns: 1fr 1fr; }
      .gt-hud > div:nth-child(2) { border-right: none; }
      .gt-hud > div:nth-child(-n+2) { border-bottom: 2px solid var(--ink); }
    }
  </style>

  <script is:inline>
  (function () {
    const cv = document.getElementById('gt-canvas');
    const ctx = cv.getContext('2d');
    const W = 960, H = 440, GROUND = 370, SQ = 30, ORIGIN = 110, BARRIER = 30;
    const INK = '#1b1712', RED = '#9b1c1c', PAPER = '#efe6d2';
    const $ = (id) => document.getElementById(id);
    const btn = $('gt-btn'), msg = $('gt-msg');

    // Resolution
    function fit() {
      const r = Math.min(window.devicePixelRatio || 1, 2);
      cv.width = W * r; cv.height = H * r; ctx.setTransform(r, 0, 0, r, 0, 0);
    }
    fit(); window.addEventListener('resize', fit);

    // Best score (local only)
    let best = null;
    try { const b = parseFloat(localStorage.getItem('dst-goblin-toss-best')); if (!isNaN(b)) best = b; } catch (e) {}
    const saveBest = (v) => { try { localStorage.setItem('dst-goblin-toss-best', String(v)); } catch (e) {} };
    const fmt = (d) => d.toFixed(1) + ' sq';
    $('gt-best').textContent = best != null ? fmt(best) : '-';

    // Weather (Krampusbowl table)
    const d6 = () => 1 + Math.floor(Math.random() * 6);
    function rollWeather() {
      const a = d6(), b = d6(), s = a + b;
      let w;
      if (s === 2) w = { name: 'Howling Winds', wind: (Math.random() < .5 ? -1 : 1) * (3 + Math.random() * 1.5), snow: 60, power: 1 };
      else if (s === 3) w = { name: 'Freezing', wind: (Math.random() * 2 - 1) * 1.2, snow: 40, power: 1, freezing: true };
      else if (s === 11) w = { name: 'Frozen Pitch', wind: (Math.random() * 2 - 1) * 1.2, snow: 30, power: 1, slide: true };
      else if (s === 12) w = { name: 'Blizzard', wind: (Math.random() * 2 - 1) * 2, snow: 260, power: .85 };
      else w = { name: 'Brisk', wind: (Math.random() * 2 - 1) * 1.2, snow: 35, power: 1 };
      w.dice = a + ' + ' + b + ' = ' + s;
      return w;
    }
    function showWeather(w) {
      $('gt-weather').textContent = w.name;
      $('gt-dice').textContent = '2D6: ' + w.dice;
      const v = Math.round(Math.abs(w.wind) * 10) / 10;
      $('gt-wind').textContent = v < .3 ? 'Calm' : (w.wind > 0 ? '→ ' : '← ') + v.toFixed(1);
    }

    // Snow particles
    let flakes = [];
    function setSnow(n) {
      flakes = Array.from({ length: n }, () => ({ x: Math.random() * W, y: Math.random() * H, r: .8 + Math.random() * 2.2, s: 20 + Math.random() * 40 }));
    }

    // State
    let state = 'ready', weather = rollWeather(), t0 = 0, angle = 0, power = 0;
    let gob = null, cam = 0, result = null, throwAnim = 0;
    showWeather(weather); setSnow(weather.snow);

    function say(main, sub) { msg.innerHTML = main ? main + (sub ? '<small>' + sub + '</small>' : '') : ''; }
    say('Tap to pick up the goblin', 'Then lock angle and power');

    function verdict(d, crowd) {
      if (crowd) return 'Crowd surf! The fans will throw him back. Eventually.';
      if (d < 3) return 'A gentle lob. The goblin is mildly offended.';
      if (d < 12) return 'Respectable. The coach nods once.';
      if (d < 20) return 'Proper Throw Team-mate distance.';
      if (d < 26) return 'That goblin has seen the clouds.';
      return 'Almost into the stands. The front row ducks.';
    }

    function act() {
      const now = performance.now();
      if (state === 'ready' || state === 'done') {
        if (state === 'done') { weather = rollWeather(); showWeather(weather); setSnow(weather.snow); }
        gob = null; cam = 0; result = null; throwAnim = 0;
        state = 'angle'; t0 = now; say(''); btn.textContent = 'Lock the angle';
      } else if (state === 'angle') {
        state = 'power'; t0 = now; btn.textContent = 'Lock the power';
      } else if (state === 'power') {
        if (Math.random() < 1 / 15) {
          state = 'done'; result = { d: 0 };
          say('Always Hungry!', 'The troll got peckish. This goblin is not going anywhere.');
          finish(0, true); return;
        }
        if (power < .15) {
          gob = { x: ORIGIN + 10, y: GROUND - 12, vx: 40, vy: 0, rot: 0, landed: true, sliding: false };
          state = 'done'; finish(Math.max(0, (gob.x - ORIGIN) / SQ), false, 'Fumble!', 'Not enough power. The goblin lands at the troll\'s feet.');
          return;
        }
        const v = 740 * (.35 + .65 * power) * weather.power;
        const a = angle * Math.PI / 180;
        gob = { x: ORIGIN + 20, y: GROUND - 120, vx: v * Math.cos(a), vy: -v * Math.sin(a), rot: 0, landed: false, sliding: false };
        state = 'fly'; throwAnim = 1; btn.textContent = 'Flying...'; btn.disabled = true;
      }
    }

    function finish(d, hungry, title, sub) {
      btn.disabled = false; btn.textContent = 'Throw another goblin';
      $('gt-last').textContent = hungry ? 'Eaten' : fmt(d);
      if (!hungry && (best == null || d > best)) { best = d; saveBest(d); $('gt-best').textContent = fmt(d); if (d > 0.5) sub = (sub ? sub + ' ' : '') + 'New personal best!'; }
      if (title) say(title, sub);
    }

    btn.addEventListener('click', act);
    cv.addEventListener('pointerdown', (e) => { e.preventDefault(); if (!btn.disabled) act(); });
    window.addEventListener('keydown', (e) => {
      if (e.code === 'Space' && document.activeElement !== btn) {
        const r = cv.getBoundingClientRect();
        if (r.bottom > 0 && r.top < window.innerHeight) { e.preventDefault(); if (!btn.disabled) act(); }
      }
    });

    // Physics
    const G = 600;
    function update(dt) {
      const now = performance.now();
      if (state === 'angle') angle = 45 + 32 * Math.sin((now - t0) / 1000 * 3.6 - Math.PI / 2);
      if (state === 'power') power = .5 - .5 * Math.cos((now - t0) / 1000 * 5.2);
      throwAnim = Math.max(0, throwAnim - dt * 3);
      if (state === 'fly' && gob) {
        if (!gob.landed) {
          gob.vx += weather.wind * 40 * dt;
          gob.vy += G * dt;
          gob.x += gob.vx * dt; gob.y += gob.vy * dt;
          gob.rot += dt * 8 * Math.sign(gob.vx || 1);
          if (gob.y >= GROUND - 12) {
            gob.y = GROUND - 12; gob.landed = true;
            if (weather.slide && gob.x < ORIGIN + BARRIER * SQ) { gob.sliding = true; gob.vx = Math.max(60, Math.abs(gob.vx) * .55) * Math.sign(gob.vx || 1); }
          }
        } else if (gob.sliding) {
          gob.x += gob.vx * dt;
          gob.vx *= Math.pow(.25, dt);
          if (Math.abs(gob.vx) < 12) gob.sliding = false;
        }
        if (gob.landed && !gob.sliding) {
          state = 'done';
          const d = Math.max(0, (gob.x - ORIGIN) / SQ);
          const crowd = d >= BARRIER;
          const feet = Math.random() < 4 / 6;
          let sub = verdict(d, crowd);
          if (!crowd) sub += feet ? ' Landed on his feet.' : (weather.freezing ? ' Splat, on granite-hard ice. +1 to the Armour roll.' : ' Splat. He\'ll be fine. Probably.');
          if (weather.slide && !crowd) sub += ' The ice added a few squares.';
          finish(d, false, fmt(d).replace('sq', 'squares'), sub);
        }
        const target = gob.x - 330;
        cam += (Math.max(0, target) - cam) * Math.min(1, dt * 6);
      } else if (state !== 'done') {
        cam += (0 - cam) * Math.min(1, dt * 4);
      }
      for (const f of flakes) {
        f.y += f.s * dt; f.x += (weather.wind * 18 + Math.sin(f.y / 30) * 6) * dt;
        if (f.y > H) { f.y = -4; f.x = Math.random() * W; }
        if (f.x > W) f.x -= W; if (f.x < 0) f.x += W;
      }
    }

    // Drawing
    function line(x1, y1, x2, y2, w, c) { ctx.strokeStyle = c || INK; ctx.lineWidth = w; ctx.beginPath(); ctx.moveTo(x1, y1); ctx.lineTo(x2, y2); ctx.stroke(); }
    function ell(x, y, rx, ry, fill, w) { ctx.beginPath(); ctx.ellipse(x, y, rx, ry, 0, 0, Math.PI * 2); ctx.fillStyle = fill; ctx.fill(); ctx.lineWidth = w || 3; ctx.strokeStyle = INK; ctx.stroke(); }

    function drawStands(off) {
      ctx.fillStyle = '#b9b0a2';
      for (let i = -1; i < 8; i++) {
        const x = i * 260 - (off * .3) % 260;
        ctx.fillRect(x, 175, 240, 120);
        ctx.fillStyle = '#a89d8d';
        for (let r = 0; r < 4; r++) ctx.fillRect(x, 195 + r * 26, 240, 6);
        ctx.fillStyle = '#b9b0a2';
        ctx.fillStyle = '#8f8476'; ctx.fillRect(x - 4, 165, 248, 12); ctx.fillStyle = '#b9b0a2';
      }
    }

    function drawTroll(x) {
      const y = GROUND;
      ell(x - 18, y - 12, 16, 10, '#6e6558'); ell(x + 20, y - 12, 16, 10, '#6e6558');
      ell(x, y - 70, 46, 56, '#8c8273', 3.5);
      ctx.fillStyle = '#c9bfae'; ctx.beginPath(); ctx.ellipse(x + 6, y - 60, 24, 30, 0, 0, Math.PI * 2); ctx.fill();
      ell(x + 8, y - 132, 20, 18, '#8c8273');
      ell(x + 15, y - 136, 3, 3, INK, 1);
      line(x + 12, y - 122, x + 26, y - 124, 3);
      ell(x - 40, y - 70, 12, 26, '#8c8273');
      // throwing arm
      const ang = (state === 'angle' || state === 'power') ? -2.2 : (-2.2 + (1 - throwAnim) * 2.4);
      const sx = x + 30, sy = y - 100;
      const ex = sx + Math.cos(ang) * 58, ey = sy + Math.sin(ang) * 58;
      ctx.lineCap = 'round';
      line(sx, sy, ex, ey, 24, INK); line(sx, sy, ex, ey, 17, '#8c8273');
      ctx.lineCap = 'butt';
      return { ex, ey };
    }

    function drawGoblin(x, y, rot, scared) {
      ctx.save(); ctx.translate(x, y); ctx.rotate(rot); ctx.scale(1.35, 1.35);
      ell(0, 4, 8, 10, '#7a5a3a', 2.5);
      ctx.fillStyle = '#7fa257'; ctx.strokeStyle = INK; ctx.lineWidth = 2.5;
      ctx.beginPath(); ctx.moveTo(-8, -12); ctx.lineTo(-22, -20); ctx.lineTo(-7, -6); ctx.closePath(); ctx.fill(); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(8, -12); ctx.lineTo(22, -20); ctx.lineTo(7, -6); ctx.closePath(); ctx.fill(); ctx.stroke();
      ell(0, -10, 9, 9, '#7fa257', 2.5);
      ell(-3, -12, scared ? 2.6 : 1.6, scared ? 2.6 : 1.6, '#fff', 1); ell(4, -12, scared ? 2.6 : 1.6, scared ? 2.6 : 1.6, '#fff', 1);
      line(-4, -5, 4, -5, 2);
      ctx.restore();
    }

    function draw() {
      // sky
      const g = ctx.createLinearGradient(0, 0, 0, GROUND);
      g.addColorStop(0, '#cfdbe3'); g.addColorStop(1, '#eef0ee');
      ctx.fillStyle = g; ctx.fillRect(0, 0, W, H);
      drawStands(cam);

      ctx.save(); ctx.translate(-cam, 0);
      // pitch
      ctx.fillStyle = '#f6f7f8'; ctx.fillRect(cam - 10, GROUND, W + 20, H - GROUND);
      line(cam - 10, GROUND, cam + W + 10, GROUND, 3);
      ctx.font = '600 13px Inter, sans-serif'; ctx.textAlign = 'center'; ctx.fillStyle = '#7a8590';
      for (let i = 0; i <= 60; i++) {
        const x = ORIGIN + i * SQ;
        if (x < cam - 40 || x > cam + W + 40) continue;
        line(x, GROUND + 2, x, H, i % 5 === 0 ? 2 : 1, i % 5 === 0 ? '#9aa6b0' : '#d3dae0');
        if (i % 5 === 0 && i > 0 && i < BARRIER) ctx.fillText(String(i), x, H - 14);
      }
      // ice sheen on frozen pitch
      if (weather.slide) { ctx.fillStyle = 'rgba(140,190,230,.25)'; ctx.fillRect(cam - 10, GROUND + 3, W + 20, H - GROUND); }
      // crowd barrier + fans
      const bx = ORIGIN + BARRIER * SQ;
      ctx.fillStyle = '#6b4f32'; ctx.fillRect(bx, GROUND - 48, 900, 48);
      line(bx, GROUND - 48, bx + 900, GROUND - 48, 3); line(bx, GROUND - 48, bx, GROUND, 3);
      for (let i = 0; i < 24; i++) {
        const fx = bx + 20 + i * 36, bob = Math.sin(performance.now() / 300 + i) * 2;
        const cols = ['#9b1c1c', '#2e5a33', '#a8833a', '#4a5a6a'];
        ell(fx, GROUND - 58 + bob, 13, 16, cols[i % 4], 2.5);
        ell(fx, GROUND - 82 + bob, 9, 9, '#e2c3a0', 2.5);
        ctx.fillStyle = cols[(i + 1) % 4]; ctx.fillRect(fx - 9, GROUND - 92 + bob, 18, 6);
      }
      // troll + goblin
      const hand = drawTroll(ORIGIN - 30);
      if (state === 'angle' || state === 'power' || state === 'ready' || (state === 'done' && !gob && !(result && result.d === 0))) {
        if (state !== 'done') drawGoblin(hand.ex, hand.ey - 10, 0, state !== 'ready');
      }
      if (gob) drawGoblin(gob.x, gob.y, gob.landed ? (gob.sliding ? 0 : 1.4) : gob.rot, true);
      if (gob && gob.y < 6) {
        ctx.fillStyle = RED; ctx.beginPath(); ctx.moveTo(gob.x, 8); ctx.lineTo(gob.x - 9, 24); ctx.lineTo(gob.x + 9, 24); ctx.closePath(); ctx.fill();
        ctx.font = '700 12px Inter, sans-serif'; ctx.textAlign = 'center'; ctx.fillStyle = INK; ctx.fillText('way up there', gob.x, 40);
      }

      // aim
      if (state === 'angle' || state === 'power') {
        const a = angle * Math.PI / 180, ox = ORIGIN + 20, oy = GROUND - 120, L = 110;
        ctx.setLineDash([8, 7]); line(ox, oy, ox + Math.cos(a) * L, oy - Math.sin(a) * L, 3, RED); ctx.setLineDash([]);
        const tx = ox + Math.cos(a) * L, ty = oy - Math.sin(a) * L;
        ctx.fillStyle = RED; ctx.beginPath(); ctx.arc(tx, ty, 6, 0, Math.PI * 2); ctx.fill();
        ctx.font = '700 15px Inter, sans-serif'; ctx.fillStyle = INK; ctx.textAlign = 'left';
        ctx.fillText(Math.round(angle) + '°', tx + 10, ty - 6);
      }
      if (state === 'power') {
        const px = ORIGIN + 70, py = GROUND - 190, ph = 150;
        ctx.fillStyle = PAPER; ctx.fillRect(px, py, 22, ph);
        const grd = ctx.createLinearGradient(0, py + ph, 0, py);
        grd.addColorStop(0, '#a8833a'); grd.addColorStop(1, RED);
        ctx.fillStyle = grd; ctx.fillRect(px, py + ph * (1 - power), 22, ph * power);
        ctx.lineWidth = 3; ctx.strokeStyle = INK; ctx.strokeRect(px, py, 22, ph);
        line(px - 4, py + ph * .85, px + 26, py + ph * .85, 2, INK);
      }
      ctx.restore();

      // snow
      ctx.fillStyle = 'rgba(255,255,255,.9)';
      for (const f of flakes) { ctx.beginPath(); ctx.arc(f.x, f.y, f.r, 0, Math.PI * 2); ctx.fill(); }
      if (weather.name === 'Blizzard') { ctx.fillStyle = 'rgba(240,244,248,.15)'; ctx.fillRect(0, 0, W, H); }

      // distance tracker
      if (gob) {
        const d = Math.max(0, (gob.x - ORIGIN) / SQ);
        ctx.font = '400 30px Anton, sans-serif'; ctx.textAlign = 'right'; ctx.fillStyle = INK;
        ctx.fillText(d.toFixed(1) + ' SQ', W - 20, 44);
      }
    }

    let last = performance.now();
    function loop(now) {
      const dt = Math.min(.05, (now - last) / 1000); last = now;
      update(dt); draw();
      requestAnimationFrame(loop);
    }
    (document.fonts ? document.fonts.ready : Promise.resolve()).then(() => requestAnimationFrame(loop));
  })();
  </script>
</Base>
